  "gaps": [
    {
      "role": "icon_eye",
      "finding": "No eye glyph exists in any of the seven packs.",
      "looked_at": "All 160 Micro Roguelike tiles, all 132 Tiny Dungeon tiles, all 83 Cartography filenames, and the 1-Bit Pack's symbol band (cells 661-1077, which holds its UI glyphs). The 1-Bit cells that read as eyes at thumbnail size (705-717) are targeting reticles.",
      "consequence": "UI.md section 2 fixes 'eye icon = infamy' as a stable signifier; changing it is a UI.md edit and the owner's call, not an import detail. The slot therefore keeps its generated icon unless the owner decides otherwise -- import_pack.py's partial-library path is exactly this case."
    },
    {
      "role": "icon_scout",
      "finding": "No boot, footprint, spyglass or map glyph exists in either coloured pack.",
      "looked_at": "All 160 Micro Roguelike tiles and all 132 Tiny Dungeon tiles, on contact sheets at 8x and again at 16x over the ranges holding items and tools (Micro Roguelike 30-43, 62-93, 112-138, 154; Tiny Dungeon 54-83, 101-131).",
      "consequence": "The lantern (microrl:39) fills the slot: the light a traveller carries to find the way, which is the nearest thing either pack offers to 'knows the way, or finds it'. The bow (microrl:72) was the other reading and lost on legibility -- it is a crossed arc that muddles into a smear at the 16-unit chip. Recorded so a later session does not re-sweep for a boot."
    }
  ],
  "chosen": {
