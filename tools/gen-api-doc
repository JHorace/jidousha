    # than no citation: it tells a game author the answer exists somewhere they
    # are not allowed to look. `scrub_internal_references` removes the
    # parenthetical form; these catch anything written another way.
    "docs/internal",
    "docs/adr",
    "e0-findings",
    "core.md",
    "renderer.md",
    "assets.md",
    "input.md",
    "tooling.md",
    "public-api.md",
    "agent-practices",
    "ADR-",
)

# What the *testing* document may say that the game document may not, and
# nothing else (ADR-0025). A picture has to be drawn by something, so a capture
# recipe cannot be written without naming the renderer it is written against.
#
# This replaces a wider exemption: the whole `jidousha::testing` reference block
# used to be cut out of the check, which meant an internal crate name or a
# pointer into `docs/internal/` could reach it unnoticed. Three words in one
# document is strictly tighter than one whole section in another.
# After ADR-0035 the testing document does not name a renderer at all: the
# capture recipe took `wgpu` and `RenderBackend` with it, and what is left is
# `FramePlan`, which a check reads for `clear_color` without rendering anything.
TESTING_VOCABULARY = ("FramePlan",)
# The capture document is the one that has to name a renderer, because a picture
# has to be drawn by something. Same three words, now spent where they are used.
CAPTURE_VOCABULARY = ("wgpu", "RenderBackend", "FramePlan")

# `(ADR-0010)`, `(core.md §9)`, `(assets.md §6)`, `(e0-findings.md F-069)`,
# `(I2)`, `(R4)` — a citation of a maintainers' document, hanging off the end of
# a sentence.
#
# The filename class carries digits because `e0-findings.md` has one, and until
# it did that file's citations were the one form of this that reached both
# generated documents: not caught here, and not caught by FORBIDDEN either,
# because the guard there names the *directory* it lives in. Two had accumulated.
CITATION_RE = re.compile(
    r"\s*\((?:see\s+)?(?:`?(?:docs/internal/)?[a-z0-9-]+\.md`?"
    r"(?:\s*(?:§[\d.]+|[MIRAF]-?\d+))?"
    r"|ADR-\d+|[MIRAF]\d+)(?:[;,]\s*[^)]*)?\)"
)

# `pub use jidousha_core::{App, Draw, ...};` — possibly across several lines.
PUB_USE_RE = re.compile(r"pub use (jidousha_\w+)(?:::(\w+))?::\{([^}]*)\}\s*;", re.S)
# `pub use jidousha_core::math;` and other single-item forms.
PUB_USE_ONE_RE = re.compile(r"pub use (jidousha_\w+)::(\w+)\s*;")

# A section banner in the facade: `// --- App and lifecycle ---...`
SECTION_RE = re.compile(r"^// --- (.+?) -+$", re.M)


def facade_exports(text: str) -> "list[tuple[str, list[str]]]":
    """The facade's root re-exports, grouped under their section banners.

    Grouping comes from the banner comments in the facade rather than from any
    knowledge here about what a `Sprite` is. Move an item to another section in
    that file and the documentation follows.
    """
    # Everything before `pub mod prelude` is the root surface; the prelude is a
    # re-export of it, and `testing` is a different audience.
    root = text.split("pub mod prelude")[0]
    groups: "list[tuple[str, list[str]]]" = []
    positions = [(match.start(), match.group(1)) for match in SECTION_RE.finditer(root)]
    for index, (start, title) in enumerate(positions):
        end = positions[index + 1][0] if index + 1 < len(positions) else len(root)
        chunk = root[start:end]
        names: "list[str]" = []
        for _, _, items in PUB_USE_RE.findall(chunk):
            names += [item.strip() for item in items.split(",") if item.strip()]
        for _, item in PUB_USE_ONE_RE.findall(chunk):
            names.append(item)
        if names:
            groups.append((title, sorted(set(names), key=str.lower)))
    return groups


def module_exports(text: str, module: str) -> "list[str]":
    """What the prelude re-exports out of one of the facade's modules.

    `pub use jidousha_core::math;` puts a module in the reference, and a module
    documented as a name says nothing: `Radians` and `sin_cos` are prelude items
    a game writes unqualified, and before this they appeared in the document
    only incidentally, inside other items' signatures.
    """
    match = re.search(rf"pub use crate::{module}::\{{([^}}]*)\}}\s*;", text, re.S)
    if not match:
        return []
    return [name.strip() for name in match.group(1).split(",") if name.strip()]


def testing_exports(text: str) -> "list[str]":
    """Everything `jidousha::testing` re-exports, sorted."""
    if "pub mod testing" not in text:
        return []
    chunk = text.split("pub mod testing")[1]
    names: "list[str]" = []
    for _, _, items in PUB_USE_RE.findall(chunk):
        names += [item.strip() for item in items.split(",") if item.strip()]
    for _, item in PUB_USE_ONE_RE.findall(chunk):
        names.append(item)
    return sorted(set(names), key=str.lower)


# `pub struct Sprite {`, `pub fn headless(`, `pub enum AssetStatus {`, ...
DEFINITION_RE = re.compile(
    r"^(\s*)pub (struct|enum|trait|fn|const|type|mod)\s+(\w+)"
)
# A member of an `impl` or `trait` body: `pub fn width_of(`, `pub const UNIT:`,
# and the trait-body form, which carries no `pub` because a trait item is
# already as public as its trait.
MEMBER_RE = re.compile(r"^(\s*)pub (?:(?:const|unsafe|async)\s+)*(fn|const)\s+(\w+)")
TRAIT_MEMBER_RE = re.compile(r"^(\s*)fn\s+(\w+)")
# `pub center: Vec2,` — a public field, with its type.
FIELD_RE = re.compile(r"^(\s*)pub (\w+): (.+?),\s*$")
# `Loading,` / `NoDisplay {` / `Rgb(u8, u8, u8)` — an enum variant.
VARIANT_RE = re.compile(r"^(\s*)([A-Z]\w*)\s*(\{|\(|,|$)")
# `#[derive(Clone, Copy, Debug)]`
DERIVE_RE = re.compile(r"^\s*#\[derive\(([^)]*)\)\]")
# `keys! {` — a macro invocation at the top level of a file.
MACRO_CALL_RE = re.compile(r"^(\w+)!\s*\{")

# Enums whose variants are written as a macro invocation rather than as an enum
# body. `Key`'s macro is the single source of truth for the variant list, the
# wire codes and the name table at once, so the invocation is where the list
# lives; scanning the `pub enum Key {` inside the macro body finds `$( $name, )*`
# and would report an empty keyboard as a fact. E0 run 1 gave up on `Escape`,
# the arrows and the digits for want of this list (e0-findings.md F-002), so the
# absence is not hypothetical.
#
# One entry is a special case; a general "resolve macro-generated enums" pass is
# not something a text extractor can do honestly. `completeness_failures` is what
# makes the next one a failed run rather than a short list.
MACRO_ENUMS = {
    # macro name -> (enum it declares, pattern matching one variant)
    "keys": ("Key", re.compile(r"^\s*(\w+)\s*=\s*\d+\s*,?")),
}

# What one scanning pass records. `DECLARATIONS` is what a name *is* — the
# struct, its fields, the enum and its variants, the trait and its methods.
# `ATTACHMENTS` is everything that hangs off a name declared somewhere else:
# `impl` members, the traits a type implements, its `Default` value, and the
# variants a registered macro writes. Two passes rather than one because
# nothing orders a crate's files so that a type is declared before every block
# that extends it, and file order is not something a doc generator may depend
# on being lucky about.
DECLARATIONS = "declarations"
ATTACHMENTS = "attachments"

# A facade module whose foreign re-exports the generator cannot document, and
# the example that documents them instead. See `render_module`.
TOURS = {"math": "crates/jidousha/examples/vec2_tour.rs"}

# How much of a member's summary rides along on its signature line. The whole
# sentence stays on the item itself; this is the reminder, not the definition.
MEMBER_SUMMARY_CHARS = 68
# A `Default` body longer than this is a paragraph, not a value — the impls line
# says `Default` and the reader goes and looks.
DEFAULT_VALUE_CHARS = 200


@dataclasses.dataclass
class Item:
    """One public item, as much of it as the sources state."""

    name: str
    kind: str = ""  # struct | enum | trait | fn | const | type | mod
    decl: str = ""  # `pub struct Camera` / the whole signature of a free fn
    summary: str = ""
    # The doc comment's first code block, rustdoc's hidden lines removed: the
    # "tiny example" third of public-api.md §4's entry spec. Empty for an item
    # whose doc comment carries no example, which is most of them.
    example: "list[str]" = dataclasses.field(default_factory=list)
    derives: "tuple[str, ...]" = ()
    traits: "list[str]" = dataclasses.field(default_factory=list)
    fields: "list[tuple[str, str]]" = dataclasses.field(default_factory=list)
    variants: "list[tuple[str, str]]" = dataclasses.field(default_factory=list)
    members: "list[tuple[str, str]]" = dataclasses.field(default_factory=list)
    # Which file each member's `impl` block was in, parallel to `members`. Kept
    # so the type's own block can be listed before blocks that extend it from
    # elsewhere: without it, `World` leads with `insert_resource` because
    # `resource.rs` sorts before `world.rs`, which is a fact about the file
    # system rather than about the type.
    member_sources: "list[str]" = dataclasses.field(default_factory=list)
    default_value: str = ""
    # Did the source open a `{ ... }` body at all, and did it contain nothing?
    # A unit struct, a marker trait and a misparsed block all look identical
    # from the outside, and only the last is a bug.
    has_body: bool = False
    empty_body: bool = False
    # Lines seen inside the body, public or not. A type whose every member is
    # private (`Entity`) reads exactly like one whose block was misparsed,
    # until you ask whether the block was read at all.
    body_lines: int = 0
    # "literal" | "macro:<name>" | "unresolved" — how the variants were found.
    variants_from: str = ""
    source: str = ""


def strip_generics(text: str) -> "tuple[str, str]":
    """Split a leading `<...>` off `text`, respecting nesting.

    `impl<'w, Q: Query<'w>> QueryIterMut<'w, Q>` is why this counts rather than
    matching `<[^>]*>`: the first `>` in that line closes an inner parameter,
    not the list.
    """
    if not text.startswith("<"):
        return "", text
    depth = 0
    for index, char in enumerate(text):
        if char == "<":
            depth += 1
        elif char == ">":
            depth -= 1
            if depth == 0:
                return text[: index + 1], text[index + 1 :].lstrip()
    return "", text


def split_trait_impl(rest: str) -> "tuple[str, str]":
    """`Trait for Type` -> (trait, type); `Type` -> ("", type).

    The split has to be at depth zero: `impl<F: for<'w> Fn(..)> IntoSystem<Draw>
    for F` has a `for` inside its parameter list, and that list is stripped
    before this sees the line — but a `for` can also appear inside the trait's
    own arguments, so depth is checked anyway.
    """
    depth = 0
    index = 0
    while index < len(rest):
        char = rest[index]
        if char in "<(":
            depth += 1
        elif char in ">)":
            depth -= 1
        elif depth == 0 and rest.startswith(" for ", index):
            return rest[:index].strip(), rest[index + 5 :].strip()
        index += 1
    return "", rest.strip()


def bare_name(text: str) -> str:
    """`DrawCtx<'w>` -> `DrawCtx`; `fmt::Debug` -> `Debug`."""
    text = text.strip().rstrip("{").strip().split("<")[0].strip()
    return text.split("::")[-1]


def indent_of(line: str) -> int:
    return len(line) - len(line.lstrip())


def closes_block(line: str, indent: int) -> bool:
    """Whether `line` is the `}` that closes a block opened at `indent`.

    Indentation, not brace depth: `cargo fmt` guarantees the closer lines up
    with its opener, and a depth counter is defeated by a brace inside a string
    literal — `write!(formatter, "TextureId({bits})")` closes two blocks early.

    The trailing punctuation varies with what was opened: a block ends `}`, a
    struct-bodied enum variant ends `},`, a const's literal ends `};`.
    """
    return line.rstrip().rstrip(",;") == " " * indent + "}"


def read_signature(lines: "list[str]", index: int) -> "tuple[str, int]":
    """The whole signature at `index`, joined onto one line.

    rustfmt puts the terminator — `) -> T {`, `;`, or the bare `{` after a
    `where` clause — back at the item's own indentation. That is the terminator.
    No paren counting, and no attempt to balance `<` against `>`, which `->`
    makes ambiguous anyway.
    """
    indent = indent_of(lines[index])
    # A `const`'s initialiser may itself open a braced literal — `pub const
    # UNIT: Rect = Rect {` — so only the semicolon ends one. Everything else
    # ends at the `{` that opens its body.
    # `pub const fn layer(..)` is a const *function*, whose body opens with `{`
    # like any other. Only an associated const runs to a semicolon.
    is_const = re.match(r"^\s*(?:pub )?const\s+(?!fn\b)", lines[index]) is not None
    parts: "list[str]" = []
    cursor = index
    while cursor < len(lines):
        raw = lines[cursor]
        parts.append(raw.strip())
        stripped = raw.rstrip()
        if stripped.endswith(";"):
            break
        # `pub trait Resource: 'static + Send + Sync {}` — an empty body ends
        # the declaration as surely as a `{` does, and reading past it swallows
        # whatever is defined next.
        if not is_const and stripped.endswith("{}"):
            break
        if not is_const and indent_of(raw) <= indent and stripped.endswith("{"):
            break
        cursor += 1
    text = re.sub(r"\s+", " ", " ".join(parts)).strip()
    text = re.sub(r"\s*\{$", "", text).strip().rstrip(";").strip()
    # rustfmt's wrapping leaves the seams behind once the lines are joined.
    text = text.replace("( ", "(").replace(" )", ")")
    text = re.sub(r",\s*\)", ")", text)
    text = re.sub(r",\s*\}", " }", text)
    return unqualify(text.rstrip(",")), cursor


def scrub_internal_references(text: str) -> str:
    """Drop citations of maintainers' documents from the game-facing text.

    A doc comment serves two readers: rustdoc, where `(ADR-0010)` is the whole
    point, and this document, whose reader is forbidden to open `docs/adr/` or
    `docs/internal/` at all (e0-prompt.md). For that reader a citation is worse
    than silence — it says the answer exists somewhere they may not look. E0 run
    1 hit exactly this on `message`, whose entry pointed at `core.md §9`
    (e0-findings.md F-005).

    Stripping on the way out is practices §2.4 — two audiences, strict
    separation — rather than a campaign to reword every doc comment in the
    crates, which would take the citation away from the reader it helps.
    """
    return CITATION_RE.sub("", text)


def unqualify(text: str) -> str:
    """Drop the internal crate from a path: `jidousha_assets::ByteSource`.

    The type is the same type; the path is the routing a facade exists to hide,
    and naming it in this document would both breach the §4 CONTRACT and send a
    game author looking for a crate they must not depend on.
    """
    return re.sub(r"\bjidousha_\w+::", "", text)


def flatten_default(lines: "list[str]", index: int) -> str:
    """The value a `fn default()` produces, as one line.

    Read from the body rather than described, because the body is the answer:
    `GameConfig::default()` is where a game learns the tick rate is 1/60, and
    that number appears nowhere else a game is allowed to look (F-004).
    """
    indent = indent_of(lines[index])
    parts: "list[str]" = []
    cursor = index + 1
    while cursor < len(lines) and not closes_block(lines[cursor], indent):
        stripped = lines[cursor].strip()
        if stripped and not stripped.startswith("//"):
            parts.append(stripped)
        cursor += 1
    text = re.sub(r"\s+", " ", " ".join(parts)).strip()
    text = re.sub(r",\s*\}", " }", text)
    return unqualify(text) if len(text) <= DEFAULT_VALUE_CHARS else ""


def macro_enum_variants(
    lines: "list[str]", index: int, pattern: "re.Pattern[str]"
) -> "tuple[list[str], list[str]]":
    """Every variant a `name! { A = 1, B = 2, ... }` invocation declares.

    Returns the variant names and the body to render, which is the invocation's
    own layout with the wire codes removed: the codes are a recording-format
    detail a game never writes, but the grouping and its comments are real
    information (letters, digit row, arrows, editing keys), and regrouping the
    list here would be a second opinion about the keyboard.

    No run compression — no `A–Z`, no `F1–F12`. Compression is precisely how a
    variant goes missing without anybody noticing, and 96 bare names cost about
    900 characters against tens of thousands spare.
    """
    names: "list[str]" = []
    body: "list[str]" = []
    cursor = index + 1
    while cursor < len(lines) and not closes_block(lines[cursor], indent_of(lines[index])):
        stripped = lines[cursor].strip()
        cursor += 1
        if not stripped or stripped.startswith("//"):
            body.append(stripped)
            continue
        found = [
            match.group(1)
            for match in (pattern.match(part.strip()) for part in stripped.split(","))
            if match
        ]
        if not found:
            continue
        names += found
        body.append(", ".join(found) + ",")
    while body and not body[-1]:
        body.pop()
    return names, body


def first_sentence(block: "list[str]") -> str:
    """The first sentence of a doc comment, joined across the lines it wraps.

    Taking the first *line* instead is what produces a reference full of
    summaries that stop mid-clause — these doc comments are wrapped at eighty
    columns, so a one-sentence summary routinely spans two lines.
    """
    text = ""
    for line in block:
        if not line and text:
            break
        text = f"{text} {line}".strip()
        if text.endswith("."):
            break
    sentence = text.split(". ")[0].rstrip(".").strip()
    # rustdoc intra-doc links mean nothing in a markdown file read by an agent;
    # the brackets around an already-code-spanned name are noise.
    sentence = re.sub(r"\[(`[^`]+`)\]", r"\1", sentence)
    return scrub_internal_references(sentence).strip()


def doc_example(block: "list[str]") -> "list[str]":
    """The doc comment's first code block, as a reader should see it.

    The third of public-api.md §4's entry spec that went unbuilt: "one entry per
    item: signature, one-liner, tiny example". These are the crate's own
    doctests, so the example in the document is an example CI compiles — the
    same argument the Quickstart is embedded verbatim for.

    **rustdoc's hidden lines are dropped**, which is not cosmetic. A doctest
    hides its setup behind `# `, and here that setup is almost always
    `# use jidousha_core::…` — the internal crate paths a doctest needs and the
    facade's reader must never see. Rendering them would put the whole
    `FORBIDDEN` list into the document by the back door. Dropping them is also
    what rustdoc shows a human, so the document and docs.rs agree.

    `##` at the start of a line is rustdoc's escape for a literal `#`, and
    `#[derive(…)]` is an attribute rather than a hidden line: neither is setup,
    and both stay.

    **Visible `use jidousha_…` lines go too**, for the same reason as the hidden
    ones and one more. A doctest imports from the crate it lives in; a reader of
    this document imports from the facade, and the document's own second
    sentence is "everything here is reachable from one import". An example
    carrying `use jidousha_core::Component;` would be telling that reader to do
    the one thing the facade exists to make unnecessary — so dropping the line
    makes the example *more* correct for the reader it is shown to, not less.
    Citations are scrubbed from comments on the same grounds as everywhere else:
    this reader may not open `docs/adr/`.
    """
    fence, body = False, []
    for line in block:
        if line.startswith("```"):
            if fence:
                break
            fence = True
            continue
        if not fence:
            continue
        bare = line.lstrip()
        if bare.startswith("##"):
            body.append(line.replace("##", "#", 1))
        elif bare == "#" or bare.startswith("# "):
            continue
        elif bare.startswith("use jidousha_"):
            continue
        elif bare.startswith("//"):
            body.append(unqualify(scrub_internal_references(line)).rstrip())
        else:
            # `jidousha_platform::asset_source(..)` written out mid-expression
            # rather than imported: the same routing `unqualify` hides in a
            # declaration, and the same reason for hiding it.
            body.append(unqualify(line))
    # Dropping the imports usually leaves the blank line that followed them.
    while body and not body[0].strip():
        body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    # A block that was nothing but setup has no example left to show.
    return body if any(line.strip() for line in body) else []


# `<!-- asserted-by: the_first_update_system_sees_tick_one -->` — the test that
# holds a claim true. On its own line, or at the end of the line it belongs to.
ASSERTED_BY_RE = re.compile(r"[ \t]*<!--\s*asserted-by:\s*([A-Za-z0-9_, ]+?)\s*-->")
ASSERTED_BY_LINE_RE = re.compile(r"^[ \t]*<!--\s*asserted-by:[^>]*-->[ \t]*\n", re.M)

# A test's definition, wherever it lives: an integration test, a unit test beside
# the code, or a check inside a worked example.
TEST_FN_RE = re.compile(r"\bfn\s+([a-z_][a-z0-9_]*)\s*\(")


def known_test_names(repo: Path) -> "set[str]":
    """Every function name defined under `crates/`.

    Function rather than `#[test]` function: a claim can be held by a named
    helper an example's `--verify` calls, and `slalom/checks.rs` is full of
    those. What this is guarding against is a name that resolves to *nothing* —
    a test renamed or deleted while the sentence it backs stayed — and for that,
    "is there something called this" is the whole question.
    """
    names = set()
    for path in repo.glob("crates/**/*.rs"):
        names.update(TEST_FN_RE.findall(path.read_text(encoding="utf-8")))
    return names


def unasserted_claims(text: str, repo: Path) -> "list[str]":
    """`asserted-by:` markers naming a test that does not exist.

    Three sentences in ten E0 runs have been **false** — a document claim
    contradicting the code it described (F-055, F-068, F-097). Each was found by a
    run leaning on it, and each fix wrote a test afterwards. That is a guard that
    arrives one sentence at a time, after the expensive part.

    This is the cheap half of a mechanism, and it is worth being exact about which
    half. It does **not** check that a claim is true; nothing mechanical can. It
    checks that a claim which *names* its test still has one, so the linkage rots
    loudly instead of silently — the same bargain as `dangling_examples`, one
    level up: there a pointer at a worked example, here a pointer at a proof.

    Scoped on purpose to claims a game's `--verify` leans on — draw order,
    `covering`'s boundary, quads per primitive, text metrics, tick numbering. A
    falsehood there makes every game's check quietly wrong, which is the case that
    justifies the ceremony. Claims about game design (F-080) and about the
    document's own coverage (F-068) are not assertable by anything and are not
    asked to be: those stay a reader's job, and saying so is part of the
    mechanism rather than an apology for it.
    """
    known = known_test_names(repo)
    missing = []
    for match in ASSERTED_BY_RE.finditer(text):
        for name in match.group(1).split(","):
            name = name.strip()
            if name and name not in known and name not in missing:
                missing.append(name)
    return missing


def visible_prose(text: str) -> str:
    """Prose with each `rust` block's hidden setup lines dropped.

    The same `# ` convention rustdoc uses, for the same reason and now in the
    hand-written half of the surface too: `tools/check-api-prose` compiles every
    block in `tools/api-doc/`, and a block that compiles needs context a reader
    does not need to see — a `sim` to tick, a `frame` to measure, a `camera` to
    ask. Hiding it keeps the block a *fragment* on the page, which is what the
    surrounding sentence is written against, while making it a *program* to the
    compiler.

    Hidden lines cost the token budget nothing, because they never reach
    `docs/api/`. That is the whole reason this is a rendering step rather than a
    convention a reader is asked to skim past.

    `##` is rustdoc's escape for a literal `#` and survives as one; `#[derive(…)]`
    is an attribute rather than setup and stays. Only `rust` blocks are touched —
    a `#` opening a line of shell or of transcript output is a comment or a
    prompt, not hidden code.

    **`<!-- asserted-by: … -->` markers go too.** They name the test that holds a
    claim true (`unasserted_claims`), which is a fact about the repository rather
    than about the game being written, and the reader of `docs/api/` cannot open
    the test anyway. Dropping them keeps the marker free: a maintainer can put one
    on every claim that deserves it without spending a token.
    """
    text = ASSERTED_BY_LINE_RE.sub("", text)
    text = ASSERTED_BY_RE.sub("", text)
    out, in_rust = [], False
    for line in text.splitlines():
        stripped = line.lstrip()
        if stripped.startswith("```"):
            in_rust = stripped.startswith("```rust")
            out.append(line)
            continue
        if in_rust:
            if stripped.startswith("##"):
                out.append(line.replace("##", "#", 1))
                continue
            if stripped == "#" or stripped.startswith("# "):
                continue
        out.append(line)
    return "\n".join(out)


def crate_of(source: str) -> str:
    """The crate a source path belongs to, spelled as the facade imports it."""
    parts = Path(source).parts
    if "crates" in parts:
        return parts[parts.index("crates") + 1].replace("-", "_")
    return ""


def defining_crates(sources: "list[Path]") -> "dict[str, set[str]]":
    """Every top-level public item name, and the crates that define one.

    Only top-level declarations: a member of an `impl` block is scoped by its
    type and cannot collide across crates the way a free function can.
    """
    found: "dict[str, set[str]]" = {}
    for source in sources:
        crate = crate_of(str(source))
        try:
            lines = source.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            match = DEFINITION_RE.match(line)
            if match and match.group(1) == "":
                found.setdefault(match.group(3), set()).add(crate)
    return found


def exporting_crate(facade: str) -> "dict[str, str]":
    """Which crate the facade re-exports each name from."""
    out: "dict[str, str]" = {}
    for crate, _, items in PUB_USE_RE.findall(facade):
        for item in items.split(","):
            item = item.strip()
            if item:
                out[item] = crate
    for crate, item in PUB_USE_ONE_RE.findall(facade):
        out[item] = crate
    return out


def resolve_ambiguous(
    items: "dict[str, Item]", sources: "list[Path]", facade: str
) -> "list[str]":
    """Re-key any exported name two crates define, to the one the facade means.

    `scan_sources` takes the first definition of a name it meets and its docstring
    used to say why that was safe: "the facade re-exports one of each and there
    are no duplicate public type names across the crates". **That stopped being
    true and nothing noticed.** `encode_png` is defined in `jidousha-assets`
    (taking a `TextureData`) and in `jidousha-render-core` (taking a `RawImage`);
    the facade re-exports the render-core one, and the reference documented the
    other because `crates/jidousha-assets/` sorts first. A game author copying
    `encode_png(&texels)` out of the document got a type error, and the
    document's own worked example — which calls it on a captured frame — was the
    contradiction nobody read (e0-findings.md F-136).

    The facade already says which crate it means, on the `pub use` line. This
    honours it: for every colliding name, the crate's own files are rescanned and
    that definition replaces whichever one sorted first. Returns the names it had
    to disambiguate, so the run says so rather than resolving in silence — a
    silent right answer and a silent wrong one look identical from outside.
    """
    collisions = {
        name: crates for name, crates in defining_crates(sources).items() if len(crates) > 1
    }
    if not collisions:
        return []
    exported = exporting_crate(facade)
    resolved = []
    for name, crates in sorted(collisions.items()):
        crate = exported.get(name)
        if crate is None or crate not in crates:
            continue
        wanted = [source for source in sources if crate_of(str(source)) == crate]
        fresh = scan_sources(wanted)
        if name in fresh:
            items[name] = fresh[name]
            resolved.append(f"{name} (from {crate})")
    return resolved


def scan_sources(sources: "list[Path]") -> "dict[str, Item]":
    """Every public item the sources declare, by name.

    First definition wins *within* this scan, which is not the same as being
    right: two crates may define one public name, and which of them sorts first
    is a fact about the file system. `resolve_ambiguous` re-keys those to the
    crate the facade actually re-exports from, and this function is deliberately
    left simple so that it can be called again on one crate's files to get the
    other answer.

    Every file is read for declarations before any file is read for `impl`
    blocks. Attaching a member needs its type to exist already, and a type's
    blocks are not obliged to live in the file that declares it: `World`'s
    resource API is in `resource.rs`, `InputSnapshot::encode` is in `codec.rs`,
    and both sort ahead of the file that declares the type. One ordered pass
    looked those types up, found nothing, and threw the members away without a
    word — `World` reached the reference with seventeen methods and none of the
    five a game calls to reach a resource (e0-findings.md F-016). Two passes
    make path order stop mattering, which is the only fix that also covers the
    next file somebody adds.
    """
    files: "list[tuple[list[str], str]]" = []
    for source in sources:
        try:
            files.append((source.read_text(encoding="utf-8").splitlines(), str(source)))
        except OSError:
            continue
    items: "dict[str, Item]" = {}
    for phase in (DECLARATIONS, ATTACHMENTS):
        for lines, source in files:
            scan_file(lines, source, items, phase)
    for item in items.values():
        order_members(item)
    return items


def order_members(item: Item) -> None:
    """List the type's own `impl` block before blocks that extend it elsewhere.

    A stable partition, so within each file the source order is untouched. The
    two passes above made the *presence* of a member independent of path order;
    this makes its position independent too, which is what stops a file rename
    from reshuffling the reference.
    """
    if len(set(item.member_sources)) < 2:
        return
    order = sorted(
        range(len(item.members)),
        key=lambda position: item.member_sources[position] != item.source,
    )
    item.members = [item.members[position] for position in order]
    item.member_sources = [item.member_sources[position] for position in order]


def scan_file(lines: "list[str]", source: str, items: "dict[str, Item]", phase: str) -> None:
    """Read one file into `items`, recording what `phase` asks for.

    A small state machine over a stack of open blocks. Each frame is
    `(what, indent, target)`, and a frame is popped when a `}` shows up at its
    own indentation — see `closes_block` for why that beats counting braces.

    Both phases walk the whole file and open the same frames; they differ only
    in what they write down. Frames have to be opened either way, because it is
    the frame stack that tells a `pub fn` inside an `impl` block apart from a
    free function at the top of the file.
    """
    # (what, indent, target): "impl" | "trait" | "body" | "default" | "skip"
    stack: "list[tuple[str, int, str]]" = []
    doc: "list[str]" = []
    derives: "tuple[str, ...]" = ()
    index = 0
    while index < len(lines):
        line = lines[index]
        while stack and closes_block(line, stack[-1][1]):
            stack.pop()
        stripped = line.strip()

        # Doc comments and attributes accumulate onto whatever comes next.
        if stripped.startswith("///"):
            # Only the one space rustdoc puts after the slashes comes off, so a
            # doctest's own indentation survives into the document. Stripping
            # both ends flattened every nested example in all three files — an
            # `if` inside an `fn` came out flush against the margin, in the
            # documents whose whole job is to be copied from (F-114's fix wrote
            # the first one that made it obvious).
            body = stripped[3:]
            doc.append((body[1:] if body.startswith(" ") else body).rstrip())
            index += 1
            continue
        if stripped.startswith("#["):
            match = DERIVE_RE.match(line)
            if match:
                derives = tuple(part.strip() for part in match.group(1).split(","))
            index += 1
            continue
        if not stripped or stripped.startswith("//"):
            doc, derives = [], ()
            index += 1
            continue

        summary, example = first_sentence(doc), doc_example(doc)
        doc, held_derives = [], derives
        derives = ()
        top = stack[-1] if stack else ("", -4, "")

        if stripped.startswith("impl") and re.match(r"^\s*impl[\s<]", line):
            index = enter_impl(lines, index, line, stack, items, phase)
            continue

        match = DEFINITION_RE.match(line)
        # `not stack` rather than `indent == 0`: `pub enum Key` is written inside
        # `macro_rules! keys`, which opens no frame here, and skipping it would
        # lose the one enum the document most needs (F-002).
        if match and not stack:
            index = enter_definition(
                lines, index, match, summary, example, held_derives, source, stack, items, phase
            )
            continue

        # A trait's own methods are part of its declaration; an `impl` block's
        # are attached to a type declared elsewhere. Same frame handling, two
        # different phases.
        member_phase = DECLARATIONS if top[0] == "trait" else ATTACHMENTS

        if phase == ATTACHMENTS and top[0] == "default" and re.match(r"^\s*fn default\(", line):
            item = items.get(top[2])
            if item is not None:
                item.default_value = flatten_default(lines, index)
            index += 1
            continue

        if phase == member_phase and top[0] in ("impl", "trait") and indent_of(line) == top[1] + 4:
            item = items.get(top[2])
            member = MEMBER_RE.match(line) or (
                TRAIT_MEMBER_RE.match(line) if top[0] == "trait" else None
            )
            if item is not None and member:
                signature, index = read_signature(lines, index)
                item.members.append((clean_member(signature), summary))
                item.member_sources.append(source)
                index += 1
                continue

        if phase == DECLARATIONS and top[0] == "body" and indent_of(line) == top[1] + 4:
            item = items.get(top[2])
            if item is not None:
                item.body_lines += 1
            if item is not None and item.kind == "struct":
                field = FIELD_RE.match(line)
                if field:
                    text = unqualify(f"pub {field.group(2)}: {field.group(3)}")
                    item.fields.append((text, summary))
            elif item is not None and item.kind == "enum":
                variant = VARIANT_RE.match(line)
                if variant:
                    text, index = read_variant(lines, index)
                    item.variants.append((text, summary))

        # In the attachment phase, so the invocation may sit in any file — the
        # enum it fills in has certainly been declared by now.
        if phase == ATTACHMENTS and not stack and (macro := MACRO_CALL_RE.match(line)):
            index = enter_macro_enum(lines, index, macro.group(1), items)
            continue

        index += 1


def enter_impl(
    lines: "list[str]",
    index: int,
    line: str,
    stack: "list[tuple[str, int, str]]",
    items: "dict[str, Item]",
    phase: str,
) -> int:
    """Push a frame for an `impl` block and record what it says about its type.

    The frame is pushed in both phases and the recording happens in one: a
    declaration pass that did not open this frame would read the block's `pub
    fn`s as free functions.
    """
    indent = indent_of(line)
    _, rest = strip_generics(line.strip()[4:].lstrip())
    trait, target = split_trait_impl(rest)
    name = bare_name(target)
    item = items.get(name)
    if trait:
        trait_name = bare_name(trait)
        if phase == ATTACHMENTS and item is not None and trait_name not in item.traits:
            item.traits.append(trait_name)
        # A trait's methods belong to the trait's own declaration. Attributing
        # them to the type too would put `rect` on `DrawCtx`'s inherent list and
        # say, wrongly, that it resolves without the trait in scope.
        stack.append(("default" if trait_name == "Default" else "skip", indent, name))
    else:
        stack.append(("impl", indent, name))
    if line.rstrip().endswith("{}"):
        stack.pop()
    return index + 1


def enter_definition(
    lines: "list[str]",
    index: int,
    match: "re.Match[str]",
    summary: str,
    example: "list[str]",
    derives: "tuple[str, ...]",
    source: str,
    stack: "list[tuple[str, int, str]]",
    items: "dict[str, Item]",
    phase: str,
) -> int:
    """Create the `Item` for a top-level `pub` definition.

    The frame is pushed on every pass and the item is filled in on the first
    one that sees it — a later pass walks the same block and writes nothing,
    which is what keeps fields and variants from being recorded twice.
    """
    indent, kind, name = len(match.group(1)), match.group(2), match.group(3)
    line = lines[index]
    item = items.setdefault(name, Item(name=name))
    # First definition wins, as the summaries always have.
    first = not item.kind
    if first:
        item.kind, item.summary, item.derives, item.source = kind, summary, derives, source
        item.example = example
    if kind in ("fn", "const", "type"):
        decl, index = read_signature(lines, index)
        if first:
            item.decl = decl
        return index + 1
    decl, _ = read_signature(lines, index)
    if first:
        item.decl = decl
    if line.rstrip().endswith("{"):
        stack.append(("trait" if kind == "trait" else "body", indent, name))
        if first:
            item.has_body = True
            item.empty_body = (
                closes_block(lines[index + 1], indent) if index + 1 < len(lines) else False
            )
            if kind == "enum":
                item.variants_from = "unresolved" if templated(lines, index, indent) else "literal"
    elif first and line.rstrip().endswith("{}"):
        item.empty_body = True
    return index + 1


def templated(lines: "list[str]", index: int, indent: int) -> bool:
    """Whether a block's body is macro substitution rather than literal items.

    `pub enum Key {` inside `macro_rules! keys` has a body of `$( $name, )*`.
    Saying so is the difference between a bug and a report: an empty variant
    list rendered as fact is what E0 read as "this keyboard has no keys".
    """
    cursor = index + 1
    while cursor < len(lines) and not closes_block(lines[cursor], indent):
        if "$" in lines[cursor]:
            return True
        cursor += 1
    return False


def read_variant(lines: "list[str]", index: int) -> "tuple[str, int]":
    """One enum variant, flattened — `NoDisplay { detail: String }`."""
    line = lines[index]
    stripped = line.rstrip()
    if not stripped.endswith("{"):
        return stripped.strip().rstrip(","), index
    indent = indent_of(line)
    parts = [stripped.strip()]
    cursor = index + 1
    while cursor < len(lines) and not closes_block(lines[cursor], indent):
        inner = lines[cursor].strip()
        if inner and not inner.startswith(("///", "//", "#[")):
            parts.append(inner)
        cursor += 1
    text = re.sub(r"\s+", " ", " ".join(parts)).strip().rstrip(",")
    return re.sub(r",\s*$", "", text) + " }", cursor


def enter_macro_enum(
    lines: "list[str]", index: int, macro: str, items: "dict[str, Item]"
) -> int:
    """Resolve a registered macro invocation into its enum's variant list."""
    entry = MACRO_ENUMS.get(macro)
    if entry is None:
        return index + 1
    name, pattern = entry
    item = items.get(name)
    if item is None:
        return index + 1
    names, body = macro_enum_variants(lines, index, pattern)
    if names:
        item.variants = [(text, "") for text in body]
        item.variants_from = f"macro:{macro}"
        item.decl = item.decl or f"pub enum {name}"
    return index + 1


def clean_member(signature: str) -> str:
    """A member signature as the reference shows it: declaration, no body.

    A `const`'s initialiser is the value and stays; one written in macro
    substitution (`&[$(Key::$name),*]`) is not something a game can read, so it
    goes and the declaration remains.
    """
    signature = signature.strip().rstrip(";").strip()
    if "$" in signature:
        signature = signature.split("=")[0].strip()
    return signature + ";"


def doc_summaries(sources: "list[Path]") -> "dict[str, str]":
    """The first sentence of each public item's doc comment, by item name.

    Kept as the narrow view over `scan_sources`: the summary a game-writing
    agent reads is the one the code carries, so a doc comment and its
    documentation cannot disagree.
    """
    return {name: item.summary for name, item in scan_sources(sources).items() if item.summary}


def crate_sources(repo: Path) -> "list[Path]":
    """Every Rust source the facade could be re-exporting from."""
    return sorted(repo.glob("crates/jidousha-*/src/**/*.rs"))


def member_lines(text: str, summary: str, indent: str = "    ") -> "list[str]":
    """One member: its signature, and **the whole** of its summary.

    A short summary rides along on the signature line, which is the densest form
    and what most members get. One too long for that goes on its own line above
    the signature, wrapped — it is *not* cut short.

    That is the fix for four of E0 run 4's sixteen findings (F-039, F-043,
    F-048, and the wording half of F-050). This function used to truncate at
    `MEMBER_SUMMARY_CHARS` and append an ellipsis, on the stated grounds that
    "the whole sentence stays on the item it belongs to; this is the reminder".
    **That premise was false**: a member has no entry of its own anywhere in
    this document, so its summary appears here and nowhere else, and the
    truncated tail was not kept somewhere — it was deleted. `Time::alpha`
    explained itself in four lines and the reference printed a clause that
    stopped mid-word. The reader could not tell a sentence had been cut from a
    sentence that was simply short.

    Costing a line is the right trade: a document that is a few lines longer
    beats one that silently drops the half of a sentence carrying the number.
    """
    if not summary:
        return [f"{indent}{text}"]
    if len(summary) <= MEMBER_SUMMARY_CHARS:
        return [f"{indent}{text}  // {summary}"]
    wrapped = textwrap.wrap(summary, width=MEMBER_SUMMARY_CHARS + 8) or [summary]
    return [f"{indent}// {line}" for line in wrapped] + [f"{indent}{text}"]


def declaration(item: Item) -> "list[str]":
    """The Rust block for one item: what it is, and how to call it.

    A header-file shape rather than a bullet list. It is the densest encoding of
    an API there is, and it is the form the reader's own output has to be in.
    """
    out: "list[str]" = []
    if item.kind in ("fn", "const", "type", "mod"):
        return [item.decl + ";" if item.kind != "mod" else item.decl]

    if item.kind == "struct" and item.fields:
        out.append(item.decl + " {")
        for text, summary in item.fields:
            out += member_lines(f"{text},", summary)
        out.append("}")
    elif item.kind == "enum" and item.variants:
        out.append(item.decl + " {")
        for text, summary in item.variants:
            if not text:
                out.append("")
            elif text.startswith("//"):
                out.append(f"    {text}")
            else:
                comma = "" if text.endswith(",") else ","
                out += member_lines(f"{text}{comma}", summary)
        out.append("}")
    elif item.kind == "trait" and item.members:
        out.append(item.decl + " {")
        for text, summary in item.members:
            out += member_lines(text, summary)
        out.append("}")
    else:
        out.append(item.decl if item.decl.endswith("{}") else item.decl + ";")

    badges = list(item.derives) + [name for name in item.traits if name != "Default"]
    if badges:
        out.append(f"// {' '.join(badges)}")
    if item.default_value:
        value = re.sub(r"^Self\b", item.name, item.default_value)
        out.append(f"// Default = {value}")
    elif "Default" in item.traits:
        out.append("// Default")

    if item.members and item.kind != "trait":
        out.append("")
        out.append(f"impl {item.name} {{")
        for text, summary in item.members:
            out += member_lines(text, summary)
        out.append("}")
    return out


def render_module(
    item: Item, facade: str, items: "dict[str, Item]", repo: Path
) -> "list[str]":
    """The items a facade module contributes to the prelude, each as an entry.

    Names with no local definition are re-exports of a dependency's types
    (`Vec2`, `Vec3`, `Mat4` come from glam). There is nothing here to generate
    an entry from, and a hand-copied method list would be the one thing in this
    document that could go stale without CI noticing.

    So the entry is an **example** instead. E0 run 2 pointed out that "documented
    there" sits under a document opening "if something you want is not here, it
    is not part of v1", while `Vec2` is in nearly every line of a game and its
    docs are not in the container (e0-findings.md F-018). `TOURS` names the file
    that stands in, and cargo compiles it and `tools/test` runs it — the same
    trick the Quickstart uses, for the same reason.
    """
    out: "list[str]" = []
    foreign: "list[str]" = []
    for name in module_exports(facade, item.name):
        member = items.get(name)
        if member is None or not member.kind:
            foreign.append(name)
            continue
        out += render_item(member)
    if not foreign:
        return out
    out += [
        f"Also in `{item.name}`, re-exported from `glam`: "
        f"{', '.join(f'`{name}`' for name in foreign)}. This repository does not "
        "own their documentation, so what follows is a worked file rather than a "
        "generated entry — it compiles and runs on every test run.",
        "",
    ]
    tour = repo / TOURS[item.name] if item.name in TOURS else None
    if tour is not None:
        out += ["```rust", tour.read_text(encoding="utf-8").rstrip(), "```", ""]
    return out


def render_item(item: Item) -> "list[str]":
    """One reference entry: heading, one-liner, declaration, and an example.

    public-api.md §4's spec in full. The example is the crate's own doctest, so
    it is code CI compiles rather than code someone typed into a document —
    which is the same reason the Quickstart is an example file embedded
    verbatim.
    """
    out = [f"#### `{item.name}`", ""]
    if item.summary:
        out += [f"{item.summary}.", ""]
    block = declaration(item)
    if block:
        out += ["```rust"] + block + ["```", ""]
    if item.example:
        out += ["```rust"] + item.example + ["```", ""]
    return out


def conventions_digest(text: str) -> str:
    """The parts of `docs/conventions.md` a game needs, without the rationale.

    Sections are taken whole; the file is written for exactly this audience and
    summarizing it here would create a second copy to keep true.
    """
    keep = ("Coordinates and space", "Time", "Color", "Draw ordering", "Math")
    out: "list[str]" = []
    current = None
    for line in text.splitlines():
        if line.startswith("## "):
            current = line[3:].strip()
            if current in keep:
                out.append(f"### {current}")
            continue
        if current in keep:
            out.append(line)
    return scrub_internal_references("\n".join(out).strip())


@dataclasses.dataclass
class Document:
    """One generated file, and the two rules it is held to.

    Modelled rather than written out twice: the budget check, the vocabulary
    check and the staleness check are one piece of code each, applied to a list.
    Two copies of the staleness check is precisely the drift this tool exists to
    catch (e0-findings.md F-016).
    """

    path: Path
    budget: int
    # Words from FORBIDDEN this document is allowed to use.
    allowed: "tuple[str, ...]"
    text: str


def documents(repo: Path) -> "list[Document]":
    """Every generated document, from one scan of the sources.

    **Three documents, split by what the reader is doing** (ADR-0025, ADR-0030):
    the game document is how a game is written, the testing document is how it is
    checked, and the controllers document is how the player inside that check is
    written. Each split happened when one part crowded another out of a budget
    that belongs to a different reader.
    """
    facade = (repo / "crates/jidousha/src/lib.rs").read_text(encoding="utf-8")
    sources = crate_sources(repo)
    items = scan_sources(sources)
    for name in resolve_ambiguous(items, sources, facade):
        print(f"[gen-api-doc] two crates define {name}; the facade's is the one documented")
    return [
        Document(
            path=GAME_OUTPUT,
            budget=GAME_BUDGET,
            allowed=(),
            text=render_game(repo, facade, items),
        ),
        Document(
            path=TESTING_OUTPUT,
            budget=TESTING_BUDGET,
            allowed=TESTING_VOCABULARY,
            text=render_testing(repo, facade, items),
        ),
        Document(
            path=CAPTURE_OUTPUT,
            budget=CAPTURE_BUDGET,
            allowed=CAPTURE_VOCABULARY,
            text=render_capture(repo, facade, items),
        ),
        Document(
            path=CONTROLLERS_OUTPUT,
            budget=CONTROLLERS_BUDGET,
            # No renderer is named here: a controller decides what to press and
            # never draws, so this one is held to the game document's vocabulary
            # rather than the testing document's.
            allowed=(),
            text=render_controllers(repo),
        ),
    ]


def render_game(repo: Path, facade: str, items: "dict[str, Item]") -> str:
    """The document a game is written from."""
    quickstart = (repo / "crates/jidousha/examples/quickstart.rs").read_text(encoding="utf-8")
    concepts = visible_prose((repo / "tools/api-doc/concepts.md").read_text(encoding="utf-8")).strip()
    conventions = (repo / "docs/conventions.md").read_text(encoding="utf-8")

    out = [
        "# Jidousha — the API a game is written against",
        "",
        "GENERATED by `tools/gen-api-doc`. Do not edit; edit the facade crate, the",
        "example, or `tools/api-doc/` and regenerate.",
        "",
        "Everything here is reachable from one import:",
        "",
        "```rust",
        "use jidousha::prelude::*;",
        "```",
        "",
        "There is no other crate to depend on and nothing below this surface to",
        "reach for. If something you want is not here, it is not part of v1.",
        "",
        "**Checking the game you write is the other document**,",
        "`docs/api/jidousha-testing.md` — headless runs, asserting on what was drawn,",
        "the `--verify` convention, and capturing a picture. Write the game from this",
        "one; write the check from that one.",
        "",
        "**And a third, for one job:** `docs/api/jidousha-controllers.md` is how to write",
        "the *player* inside that check — the thing that presses the keys — so that what",
        "it reports is about the game rather than about itself. Read it last, and only",
        "once a `--verify` mode needs a player that can win.",
        "",
        "## Quickstart",
        "",
        "A whole game. Copy it, run it, start changing things.",
        "",
        "```rust",
        quickstart.rstrip(),
        "```",
        "",
        "## Concepts",
        "",
        concepts,
        "",
        "## Reference",
        "",
    ]
    for title, names in facade_exports(facade):
        out.append(f"### {title}")
        out.append("")
        for name in names:
            item = items.get(name, Item(name=name))
            out += render_item(item)
            if item.kind == "mod":
                out += render_module(item, facade, items, repo)

    if testing_exports(facade):
        # A signpost, not a section: a reader scanning the groups would
        # otherwise find `jidousha::testing` missing and conclude it does not
        # exist. The one thing a split surface has to pay for is discoverability.
        out += [
            "### Testing (`jidousha::testing`)",
            "",
            "Not part of a shipped game, and not in this document. Every signature is",
            "in `docs/api/jidousha-testing.md`.",
            "",
        ]

    out += [
        "## Conventions",
        "",
        conventions_digest(conventions),
        "",
        "## Testing your game",
        "",
        "`docs/api/jidousha-testing.md`, in full: how to run the game headless, how to",
        "ask what it drew, how to script or drive its input, the `--verify` convention",
        "`tools/verify` expects, and how to capture a picture of a frame.",
        "",
        "It is a separate document because it is read at a different time. This one is",
        "read while the game is being written; that one is read once there is a game to",
        "check, and nothing in it helps you write the game itself.",
        "",
        "**Driving that check is a third document**, `docs/api/jidousha-controllers.md`:",
        "how to write the player it plays with, why one controller cannot measure a",
        "game's difficulty, and the three numbers a controller has to report about",
        "itself. `crates/jidousha/examples/slalom/` is all of it worked. Read it third",
        "or not at all — a check whose player is a blind `InputScript` never needs it.",
        "",
        "**And a fourth, read last:** `docs/api/jidousha-capture.md` is how one recorded",
        "frame is rendered for real and written out as a PNG. A picture answers what no",
        "assertion reaches — whether it *looks* like the game — and it is the instrument",
        "that catches a frame every check was happy with.",
        "",
    ]
    return "\n".join(out)


def render_testing(repo: Path, facade: str, items: "dict[str, Item]") -> str:
    """The document a game's check is written from."""
    testing = visible_prose((repo / "tools/api-doc/testing.md").read_text(encoding="utf-8")).strip()

    out = [
        "# Jidousha — checking a game you wrote",
        "",
        "GENERATED by `tools/gen-api-doc`. Do not edit; edit the facade crate or",
        "`tools/api-doc/` and regenerate.",
        "",
        "The other half of `docs/api/jidousha-api.md`: that document is how a game is",
        "written, this one is how it is checked. It assumes the game exists and that",
        "you know how it works — so nothing here repeats the Concepts, and every type",
        "the game itself is made of is in that document rather than this one.",
        "",
        "The Reference at the end is one import:",
        "",
        "```rust",
        "use jidousha::testing::*;",
        "```",
        "",
        "The prose before it also uses the game's own vocabulary — `headless`,",
        "`GameConfig`, `Vec2` and the rest come from `jidousha::prelude` and are",
        "documented in the other file. A check imports both.",
        "",
        "**Nothing here names a renderer.** A check asserts on what was *submitted*,",
        "which needs no GPU and no window: `FramePlan` appears because a recorded frame",
        "carries the colour the camera cleared to, and that is the whole of it. Drawing",
        "a frame for real is `docs/api/jidousha-capture.md`, which is the one document",
        "that names a backend, and the one to read after this.",
        "",
        "## Testing your game",
        "",
        testing,
        "",
        "## Reference",
        "",
    ]
    testing_names = [name for name in testing_exports(facade) if name not in CAPTURE_ITEMS]
    if testing_names:
        out += [
            "### `jidousha::testing`",
            "",
            "The vocabulary a test or a `--verify` mode uses, and nothing a shipped game",
            "needs.",
            "",
        ]
        for name in testing_names:
            out += render_item(items.get(name, Item(name=name)))
    return "\n".join(out)


def render_capture(repo: Path, facade: str, items: "dict[str, Item]") -> str:
    """The document a game's capture path is written from.

    The fourth split (ADR-0035), on ADR-0025's rule: taking a picture is a
    distinct task, done last, by a reader whose `--verify` mode already runs. It
    is the first split to move *reference* entries as well as prose, which is why
    `CAPTURE_ITEMS` exists and why the borrowed vocabulary is named below rather
    than duplicated.
    """
    capture = visible_prose((repo / "tools/api-doc/capture.md").read_text(encoding="utf-8")).strip()

    out = [
        "# Jidousha — taking a picture of a frame",
        "",
        "GENERATED by `tools/gen-api-doc`. Do not edit; edit the facade crate or",
        "`tools/api-doc/` and regenerate.",
        "",
        "The fourth of four, and the last one to read. `docs/api/jidousha-api.md` is how",
        "a game is written, `docs/api/jidousha-testing.md` is how it is checked, and this",
        "is how one frame of it is rendered for real and written out as a PNG.",
        "",
        "**It assumes the checking document.** `FrameRecord`, `FrameRecorder`,",
        "`FramePlan`, `BackendTextureId` and `PhysicalSize` are defined there and are not",
        "repeated here — a capture path is written beside a `--verify` mode that already",
        "has them. The Reference at the end is the rest, and the same one import:",
        "",
        "```rust",
        "use jidousha::testing::*;",
        "```",
        "",
        "**This document names a renderer and the other three do not.** A picture has to",
        "be drawn by something, so `WgpuBackend` is here and nowhere else. A shipped game",
        "still never names a backend — only a capture path does.",
        "",
        "## Taking a picture",
        "",
        capture,
        "",
        "## Reference",
        "",
        "### `jidousha::testing`, the rendering half",
        "",
        "What a capture path calls and a check that never renders does not.",
        "",
    ]
    for name in [item for item in testing_exports(facade) if item in CAPTURE_ITEMS]:
        out += render_item(items.get(name, Item(name=name)))
    return "\n".join(out)


def render_controllers(repo: Path) -> str:
    """The document the player inside a check is written from.

    Prose only, and deliberately: a controller is written with the game's own
    vocabulary plus `InputScript` and `SnapshotBuilder`, and both of those have
    reference entries in the testing document. A second copy of them here would
    be a second place to keep them right.
    """
    controllers = visible_prose((repo / "tools/api-doc/controllers.md").read_text(encoding="utf-8")).strip()
    return "\n".join(
        [
            "# Jidousha — driving a game you cannot watch",
            "",
            "GENERATED by `tools/gen-api-doc`. Do not edit; edit `tools/api-doc/` and",
            "regenerate.",
            "",
            "The third of three, and the last one you need. `docs/api/jidousha-api.md` is",
            "how a game is written; `docs/api/jidousha-testing.md` is how it is checked;",
            "this one is how the *player* inside that check is written. It assumes both —",
            "the game exists, its `--verify` mode runs, and the only question left is",
            "whether the thing pressing the keys is good enough for its report to mean",
            "anything.",
            "",
            "**Nothing here is about this engine**, which is why it is a file rather than a",
            "section. Every claim in it would be true of a driving game or a fighting game,",
            "and it is separate so that the document about *checking* a game does not spend",
            "a seventh of itself on advice that is not about checking.",
            "",
            "## Driving a game you cannot watch",
            "",
            controllers,
            "",
        ]
    )


def token_estimate(text: str) -> int:
    """Roughly how many tokens the document costs. See `CHARS_PER_TOKEN`."""
    return len(text) // CHARS_PER_TOKEN


def completeness_failures(
    groups: "list[tuple[str, list[str]]]",
    testing_names: "list[str]",
    items: "dict[str, Item]",
) -> "list[str]":
    """Every exported item yielded something, or the run fails.

    This reference's failure mode is not being wrong — it is being **thin**, and
    a thin entry looks exactly like a complete one to the agent reading it. E0
    run 1 read `**Key** — A physical key, by position on the keyboard` and had
    no way to tell that eighty-three variant names had gone missing between the
    source and the page (e0-findings.md F-002). Each rule below turns one of
    those into an exit code, so the next construct this extractor does not
    understand is a failed run rather than a short list.
    """
    exported = [name for _, names in groups for name in names] + testing_names
    failures: "list[str]" = []
    for name in exported:
        item = items.get(name)
        if item is None or not item.kind:
            failures.append(
                problem(
                    f"the API document has nothing to say about `{name}`",
                    "the facade exports it and no definition was found in the crates",
                    "the item was renamed, moved, or is produced by a macro the "
                    "generator does not read",
                    f"check how `{name}` is defined; if a macro declares it, register "
                    "the macro in MACRO_ENUMS or extend the scanner",
                )
            )
            continue
        where = f"defined in {item.source}"
        if item.kind == "enum" and not item.variants:
            failures.append(
                problem(
                    f"the enum `{name}` reached the document with no variants",
                    where,
                    "its variants are written by a macro, or in a shape the scanner "
                    "does not recognise",
                    "register the macro in MACRO_ENUMS; an enum documented without "
                    "its variants tells a game author it has none",
                )
            )
        if item.kind == "struct" and item.has_body and not item.empty_body and not item.body_lines:
            failures.append(
                problem(
                    f"the struct `{name}` has a body the generator never read",
                    where,
                    "the block opened and no line inside it was seen, so it was "
                    "misparsed — a type whose every member is private is fine, a "
                    "block that was never entered is not",
                    "check the block's formatting; the scanner closes blocks on "
                    "indentation, which assumes cargo fmt has run",
                )
            )
        if item.kind == "trait" and not item.members and not item.empty_body:
            failures.append(
                problem(
                    f"the trait `{name}` reached the document with no methods",
                    where,
                    "its body is not empty, so the block was misparsed",
                    "check the block's formatting; a marker trait is recognised by "
                    "having a literally empty body",
                )
            )
    for macro, (name, _) in MACRO_ENUMS.items():
        item = items.get(name)
        if item is not None and item.variants_from != f"macro:{macro}":
            failures.append(
                problem(
                    f"the `{macro}!` invocation that declares `{name}` was not found",
                    f"MACRO_ENUMS expects it to declare `{name}`",
                    "the macro was renamed, moved to another file, or changed shape",
                    "update MACRO_ENUMS, or remove the entry if the enum is now "
                    "written out literally",
                )
            )
    return failures


def forbidden_words(text: str, allowed: "tuple[str, ...]" = ()) -> "list[str]":
    """Implementation vocabulary that reached a generated document.

    §4 CONTRACT: `docs/api/` never mentions internal crates, the backend seam,
    archetype storage, or any implementation vocabulary. Checked on the output,
    because that is what an agent reads.

    `allowed` is the per-document exception, and only the testing document has
    one (`TESTING_VOCABULARY`). It is passed in rather than read from a global
    so the game document's call site says, by having nothing to pass, that it
    has no exceptions at all.
    """
    lowered = text.lower()
    return [
        word
        for word in FORBIDDEN
        if word not in allowed and word.lower() in lowered
    ]


def shown(path: Path) -> str:
    """A document's path as a reader would name it.

    Repo-relative where possible and absolute otherwise: a test redirects a
    document to a temporary directory to prove the staleness check bites, and a
    reporting call that raised there would make the check untestable.
    """
    try:
        return str(path.relative_to(REPO_ROOT))
    except ValueError:
        return str(path)


# `examples/pong/capture.rs`, `examples/homing.rs`, `examples/prototype_kit` —
# a pointer at a worked example, which is half of what this document promises.
EXAMPLE_RE = re.compile(r"examples/([A-Za-z0-9_][A-Za-z0-9_./-]*)")

# The example a run *writes*, deleted before the next run starts (e0-prompt.md,
# before-the-run step 2). Named here because "does the file exist" cannot see
# it: `pong/` is on disk for most of this repository's life and absent at
# exactly the moment a run would follow a pointer to it, so a check that only
# stats the path passes on the commit that introduces the bug and fails nowhere.
# That is not hypothetical — it is what happened, and this constant is the half
# of the check that catches it.
EPHEMERAL_EXAMPLES = ("pong",)


def dangling_examples(text: str, repo: Path) -> "list[str]":
    """Pointers at worked examples that name nothing on disk.

    `docs/api/` is only half a teaching surface: the other half is
    `examples/`, and a document is *entitled* to say "the whole path is in
    `examples/pong/capture.rs`" instead of repeating it. That entitlement is
    what makes a stale pointer expensive — the reader who follows it is the
    reader who most needed the example, and what they get is nothing.

    The failure this exists for is not a typo. `e0-prompt.md`'s
    before-the-run step 2 **deletes `crates/jidousha/examples/pong/`**, because
    a previous run's finished game sitting on the allowed list is a worked
    solution the next author may read without breaking a rule. So every
    reference to `examples/pong/…` is correct while it is written and dangling
    by the time the run that needs it starts, and nothing said so: this check
    is the gate that would have caught it, and it caught exactly that pointer
    on the commit that added it.

    The same shape as `tools/check-assets`, one document up: an asset path that
    names no file, and a documentation path that names no example, fail for the
    same reason and are worth the same thirty lines.
    """
    root = repo / "crates" / "jidousha" / "examples"
    seen, missing = set(), []
    for match in EXAMPLE_RE.finditer(text):
        # A trailing `/` or `.` is sentence punctuation, not part of the path.
        reference = match.group(1).rstrip("/.")
        if not reference or reference in seen:
            continue
        seen.add(reference)
        if reference.split("/")[0] in EPHEMERAL_EXAMPLES:
            missing.append(f"examples/{reference} (deleted before the next run)")
        elif not (root / reference).exists():
            missing.append(f"examples/{reference}")
    return missing


def cut_summaries(text: str) -> "list[str]":
    """Lines inside a code block whose summary stops mid-sentence.

    The check for the bug `member_lines` fixes, kept because it is the one that
    would have caught it. Four of E0 run 4's sixteen findings were a member
    summary truncated at 68 characters, and nothing failed — a cut sentence
    looks exactly like a short one to every check the project had, and to the
    reader.

    Scoped to code blocks on purpose. Prose is allowed an ellipsis and the
    Conventions digest uses one (`Color::WHITE`, `Color::MAGENTA`, …); a
    *signature line* is never allowed one, because there is nowhere else the
    rest of that sentence could be.
    """
    cut, fence = [], False
    for line in text.splitlines():
        if line.startswith("```"):
            fence = not fence
        elif fence and line.rstrip().endswith("…"):
            cut.append(line.strip())
    return cut


def problem(what: str, specifics: str, cause: str, fix: str) -> str:
    return f"[jidousha] {what}\n  {specifics}\n  likely cause: {cause}\n  fix: {fix}"


def main(argv: "list[str]") -> int:
    check_only = "--check" in argv[1:]
    try:
        generated = documents(REPO_ROOT)
    except OSError as error:
        print(
            problem(
                "could not generate the API documents",
                str(error),
                "a source the generator reads was moved or removed",
                "check that the facade crate, tools/api-doc/, and the examples these "
                "documents embed — quickstart.rs and everything in TOURS — exist",
            ),
            file=sys.stderr,
        )
        return 2

    facade = FACADE.read_text(encoding="utf-8") if FACADE.exists() else ""
    items = scan_sources(crate_sources(REPO_ROOT))
    groups, testing_names = facade_exports(facade), testing_exports(facade)
    failures = completeness_failures(groups, testing_names, items)

    for document in generated:
        name = shown(document.path)
        tokens = token_estimate(document.text)
        print(
            f"[gen-api-doc] {name}: {len(document.text)} chars, "
            f"~{tokens} tokens of {document.budget}"
        )
        if tokens > document.budget:
            failures.append(
                problem(
                    f"{name} is ~{tokens} tokens, over the {document.budget} budget",
                    "everything in a document has to be relevant to what its reader is "
                    "doing, and a reference stays callable only while that holds",
                    "the public surface grew, or a prose section did",
                    "curate that document down rather than raising the budget "
                    "(public-api.md §4, ADR-0025) — the budget is the point",
                )
            )
        cut = cut_summaries(document.text)
        if cut:
            failures.append(
                problem(
                    f"{name} prints a summary that stops mid-sentence",
                    f"{len(cut)} line(s), the first being: {cut[0]}",
                    "a member's summary was truncated to ride along on its signature line",
                    "a member has no entry of its own, so the cut tail reaches the reader "
                    "nowhere — put the whole summary on its own line above the signature "
                    "(`member_lines`)",
                )
            )
        dangling = dangling_examples(document.text, REPO_ROOT)
        if dangling:
            failures.append(
                problem(
                    f"{name} points at a worked example that is not there",
                    f"missing: {', '.join(dangling)}",
                    "the example was renamed or deleted — note that a run's `pong/` is "
                    "deleted before the next run starts (e0-prompt.md), so a pointer at it "
                    "is dangling by the time it is read",
                    "point at an example that outlives a run, or drop the pointer and say "
                    "the thing in the document",
                )
            )
        leaked = forbidden_words(document.text, document.allowed)
        if leaked:
            failures.append(
                problem(
                    f"implementation vocabulary reached {name}",
                    f"found: {', '.join(leaked)}",
                    "a doc comment on a public item names an internal crate or the "
                    "backend seam",
                    "reword the doc comment at the definition; docs/api never mentions "
                    "internals (public-api.md §4). Only the testing document may name a "
                    "renderer, and only the three words in TESTING_VOCABULARY",
                )
            )

    # The `asserted-by:` markers are checked against the *source* prose rather
    # than the generated document, because rendering drops them: they are the
    # maintainer's linkage between a claim and its proof, and a reader of
    # `docs/api/` neither sees them nor could open what they name.
    for source in sorted(PROSE.glob("*.md")):
        missing = unasserted_claims(source.read_text(encoding="utf-8"), REPO_ROOT)
        if missing:
            failures.append(
                problem(
                    f"{source.relative_to(REPO_ROOT)} names a test that does not exist",
                    f"missing: {', '.join(missing)}",
                    "the test was renamed or deleted while the claim it backs stayed — "
                    "which is how a document sentence outlives the thing that made it true",
                    "point the marker at the test that holds the claim now, or write one. "
                    "If the claim has stopped being true, the sentence goes rather than "
                    "the marker",
                )
            )

    # The census is here so a human reviewing a regenerated diff sees the shape
    # move. A parser regression that halves the surface is obvious in these
    # numbers and invisible in the diff of a 1,700-line file.
    print(
        f"[gen-api-doc] {len(groups)} groups · "
        f"{sum(len(item.members) for item in items.values())} signatures · "
        f"{sum(len(item.fields) for item in items.values())} fields · "
        f"{sum(len(item.variants) for item in items.values())} variant lines"
    )

    for document in generated:
        name = shown(document.path)
        if check_only:
            current = (
                document.path.read_text(encoding="utf-8") if document.path.is_file() else None
            )
            if current != document.text:
                failures.append(
                    problem(
                        f"{name} is stale",
                        "the committed file differs from what the facade generates",
                        "the public surface or a prose section changed without "
                        "regenerating",
                        "run `tools/gen-api-doc` and commit the result",
                    )
                )
        else:
            document.path.parent.mkdir(parents=True, exist_ok=True)
            document.path.write_text(document.text, encoding="utf-8")
            print(f"[gen-api-doc] wrote {name}")

    for failure in failures:
        print(f"\n{failure}", file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
