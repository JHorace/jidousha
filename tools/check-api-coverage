#!/usr/bin/env python3
"""tools/check-api-coverage — is every public item shown in an example?

Two halves of one question, because a game-writing agent learns the API from
`docs/api/` **and** `examples/` (public-api.md §4, §5):

1. **Coverage.** Every item the facade re-exports appears in at least one
   example. An item nobody demonstrates is an item nobody can copy, and it is
   usually an item nobody needed.
2. **The facade contract.** No example names an internal crate. Games depend on
   `jidousha` only, and the examples are the worked proof — one that reached
   past the facade would be teaching something a game cannot do.

Both are grep-level and deliberately so: this answers "is there a worked
example?", not "is it a good one". E0 is the test of good.

Usage:  tools/check-api-coverage [--root <repo>]

Exit codes: 0 covered · 1 an item is undemonstrated or an example reached past
the facade · 2 the check could not run.

Key functions: `facade_items`, `example_sources`, `uncovered`, `facade_breaches`.
Depends on: the Python 3.8+ standard library only.
INVARIANT: the item list comes from the facade's own `pub use` lines, never from
a list kept here. A second copy of the inventory would be one more thing to
forget to update, and this check exists precisely because those get forgotten.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

# Where a game's examples live: beside the facade, so they can depend on it and
# on nothing else (public-api.md §5).
EXAMPLES = "crates/jidousha/examples"

# The crates an example must never name.
INTERNAL_CRATES = (
    "jidousha_core",
    "jidousha_assets",
    "jidousha_input",
    "jidousha_render_core",
    "jidousha_render_wgpu",
    "jidousha_platform",
)

PUB_USE_RE = re.compile(r"pub use (?:jidousha_\w+|crate)(?:::\w+)*::\{([^}]*)\}\s*;", re.S)
PUB_USE_ONE_RE = re.compile(r"pub use (?:jidousha_\w+|crate)::(\w+)\s*;")

# Items that cannot appear in an example by name, with the reason each is here.
# Kept short on purpose: every entry is an item no example demonstrates, which
# is a fact worth having to write down.
EXEMPT = {
    # Everything here is public API that a game *uses* without ever writing its
    # name — through method syntax, type inference, or a field. Each entry says
    # which, because "no example names it" and "no example uses it" are very
    # different facts and only the second is a problem.
    "Submit": "a trait used through method syntax: `ctx.sprite(...)` resolves through it",
    "WorldView": "reached as `ctx.world`; a game never writes the type",
    "Commands": "inferred from `world.commands()` — see examples/spawn_and_reap.rs",
    "Bundle": "a bundle is written as a tuple: `commands().spawn((Position(..), Velocity(..)))`",
    "Quad": "the sink `ctx.sprite(...)` writes into; a game submits through the verbs",
    "PointerId": "reached as `input.pointer().id`",
    "PointerState": "returned by `input.pointer()`, used by field and method",
    "TextureId": "an opaque id minted by `TextureHandle::texture_id()` for the renderer",
    "RunError": "matched out of `run`, never written: `Err(error) => eprintln!(\"{error}\")`",
    "Submissions": "reached as `sim.draw().quads()` — see examples/prototype_kit/verify.rs",
}


def facade_items(text: str) -> "list[str]":
    """Every name the facade re-exports at its root, sorted.

    The prelude is skipped: it re-exports the same names, and counting them
    twice would say nothing. `testing` is skipped too — it is verification
    vocabulary, demonstrated by the verify runs rather than by a game.
    """
    root = text.split("pub mod prelude")[0]
    names: "list[str]" = []
    for items in PUB_USE_RE.findall(root):
        names += [item.strip() for item in items.split(",") if item.strip()]
    names += PUB_USE_ONE_RE.findall(root)
    return sorted(set(names), key=str.lower)


def example_sources(repo: Path) -> "list[Path]":
    """Every example file, including those inside directory-style examples."""
    return sorted((repo / EXAMPLES).rglob("*.rs"))


def uncovered(items: "list[str]", sources: "list[Path]") -> "list[str]":
    """Items that appear in no example."""
    corpus = "\n".join(source.read_text(encoding="utf-8") for source in sources)
    missing = []
    for item in items:
        if item in EXEMPT:
            continue
        # Word-boundary, so `Rect` is not matched by `Rectangle` and `run` is
        # not matched by `running`.
        if re.search(rf"\b{re.escape(item)}\b", corpus):
            continue
        missing.append(item)
    return missing


# The verification vocabulary, which the coverage rule above cannot judge the
# same way. `jidousha::testing` is not what a *game* is written against, so an
# item here is demonstrated by a `--verify` run rather than by gameplay — and it
# was skipped entirely until ADR-0028's finding turned out to be able to recur
# unseen: six items were once exported for a road only `prototype_kit` walked,
# and nothing would have said so a second time.
TESTING_EXEMPT = {
    "PhysicalSize": "in the prelude too, and demonstrated there",
    "Input": "in the prelude too, and demonstrated there",
    "MemorySource": "in the prelude too, and demonstrated there",
    # The first thing this check found, and the answer is "keep it", which is
    # why the reason is written out. `ReplaySource` is the *asset* half of the
    # replay story: `Recording` carries a `TickRecord` per tick, a `TickRecord`
    # carries `Vec<AssetReady>` saying which loads committed when, and this is
    # what feeds that timing back in. `pong`'s `--verify` uses `Recording` and
    # has no art, so it never reaches the second half — but taking the second
    # half out would leave the reference documenting a timeline with no way to
    # replay it, which is a worse hole than an unused entry. Unlike ADR-0028's
    # six, this is not a road only one example walked; it is the far end of a
    # road the document describes.
    "ReplaySource": "the asset half of the replay story; AssetReady is reachable and this is "
    "what consumes it",
}


def testing_items(text: str) -> "list[str]":
    """Every name `jidousha::testing` re-exports."""
    block = text.split("pub mod testing")
    if len(block) < 2:
        return []
    names: "list[str]" = []
    for items in PUB_USE_RE.findall(block[1]):
        names += [item.strip() for item in items.split(",") if item.strip()]
    names += PUB_USE_ONE_RE.findall(block[1])
    return sorted(set(names), key=str.lower)


def entry_of(item: str, document: str) -> str:
    """One item's own section of the generated testing reference."""
    heading = f"#### `{item}`"
    if heading not in document:
        return ""
    # The heading is part of the entry. Left out, it survives the removal and
    # matches the item's own name — every entry would look reachable from itself.
    start = document.index(heading)
    rest = document[start + len(heading) :]
    nxt = rest.find("\n#### ")
    return heading + (rest if nxt < 0 else rest[:nxt])


def unreachable_testing(
    items: "list[str]", sources: "list[Path]", document: str
) -> "list[str]":
    """Testing exports that no example uses and no other entry names.

    Two ways to be reachable, and the second is the one a naive check gets wrong.
    An item may be **used** by an example — the ordinary case — or **named in
    another item's signature**, which is why it has an entry at all: F-017 is the
    finding that a type named in a signature and defined nowhere in the document
    is a hole, and F-036 is `Batch`, which exists here for exactly that reason.
    `RawImage` is what `capture()` returns and `DecodeError` is what
    `try_decode` can fail with; neither is written by a game and both have to be
    documented.

    What is left over is the real question: an item nobody uses and nothing
    mentions, carried in a document with a hard token budget. `ReplaySource` was
    the one this found.

    Reads the generated document rather than the doc comments, because the
    document is what the budget is spent on and what a reader sees. It is checked
    in, so a stale one is the `api-doc` phase's problem rather than this one's.
    """
    corpus = "\n".join(source.read_text(encoding="utf-8") for source in sources)
    orphans = []
    for item in items:
        if item in TESTING_EXEMPT:
            continue
        if re.search(rf"\b{re.escape(item)}\b", corpus):
            continue
        elsewhere = document.replace(entry_of(item, document), "", 1)
        if re.search(rf"\b{re.escape(item)}\b", elsewhere):
            continue
        orphans.append(item)
    return orphans


def facade_breaches(sources: "list[Path]") -> "list[tuple[str, int, str]]":
    """Examples naming an internal crate, as (file, line, crate)."""
    found = []
    for source in sources:
        for number, line in enumerate(source.read_text(encoding="utf-8").splitlines(), start=1):
            for crate in INTERNAL_CRATES:
                if re.search(rf"\b{crate}\b", line):
                    found.append((str(source), number, crate))
    return found


def problem(what: str, specifics: str, cause: str, fix: str) -> str:
    return f"[jidousha] {what}\n  {specifics}\n  likely cause: {cause}\n  fix: {fix}"


def main(argv: "list[str]") -> int:
    repo = REPO_ROOT
    if len(argv) > 2 and argv[1] == "--root":
        repo = Path(argv[2]).resolve()

    facade = repo / "crates/jidousha/src/lib.rs"
    sources = example_sources(repo)
    if not facade.is_file() or not sources:
        print(
            problem(
                "found nothing to check",
                f"looked for {facade} and examples under {repo / EXAMPLES}",
                "the check was run from outside the repository",
                "run it from the repository, or pass --root <repo>",
            ),
            file=sys.stderr,
        )
        return 2

    facade_text = facade.read_text(encoding="utf-8")
    items = facade_items(facade_text)
    missing = uncovered(items, sources)
    breaches = facade_breaches(sources)

    # The other half of the surface, which nothing checked until now.
    testing = testing_items(facade_text)
    reference = repo / "docs/api/jidousha-testing.md"
    orphans = (
        unreachable_testing(testing, sources, reference.read_text(encoding="utf-8"))
        if reference.is_file()
        else []
    )
    print(
        f"[check-api-coverage] {len(items)} public item(s), {len(testing)} testing item(s), "
        f"{len(sources)} example file(s), {len(EXEMPT) + len(TESTING_EXEMPT)} exempt"
    )

    failures = []
    for item in missing:
        failures.append(
            problem(
                f"no example demonstrates `{item}`",
                f"it is public API, and {EXAMPLES}/ never names it",
                "it was added to the facade without an example, or an example that used it "
                "was changed",
                "show it in an example — an item nobody can copy is an item nobody can use "
                "(public-api.md §5). If it genuinely cannot appear by name, add it to "
                "EXEMPT in this script with the reason",
            )
        )
    for item in orphans:
        failures.append(
            problem(
                f"nothing reaches `jidousha::testing::{item}`",
                f"no example uses it and no other reference entry names it",
                "it was exported for a road nobody walks — the shape ADR-0028 found once "
                "already, when six items were carried for a path only prototype_kit took",
                "use it in an example's `--verify`, or take it out of the facade. The "
                "testing document has a hard token budget and an entry nobody can reach "
                "spends it on nothing. If it must stay unused, add it to TESTING_EXEMPT "
                "with the reason",
            )
        )
    for path, line, crate in breaches:
        failures.append(
            problem(
                f"an example reaches past the facade: {crate}",
                f"{path}:{line}",
                "the example was written against an internal crate rather than `jidousha`",
                "import from `jidousha::prelude` — games depend on `jidousha` only, and the "
                "examples are the worked proof of it (public-api.md §1 CONTRACT)",
            )
        )

    for failure in failures:
        print(f"\n{failure}", file=sys.stderr)
    if failures:
        print(f"\n[check-api-coverage] {len(failures)} problem(s)", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
