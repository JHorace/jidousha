#!/usr/bin/env python3
"""Build one Jidousha example or game for the web, into dist/<name>/.

CONTRACT (web-publish.md §1): this is the ONLY web build path — CI, local dev,
and game repos all run this same script. `tools/serve-web` serves what this
builds; the deploy workflow (W1) uploads it verbatim.

    tools/build-web sprites             # release build into dist/sprites/
    tools/build-web sprites --debug     # unoptimized, for fast iteration
    tools/build-web --all               # the full fleet: every example and game +
                                        # the root index page (what PR previews
                                        # deploy — the diagnostic surface, §3)
    tools/build-web --release-fleet     # the release fleet: every game + the
                                        # examples RELEASE_EXAMPLES allows (what
                                        # the production deploy serves, §3a)

The pipeline: cargo build for wasm32 (release by default — what ships is what
gets tested), wasm-bindgen to generate the JS glue, wasm-opt -Os if installed
(optional; skipped with a log line), then stage the playtest page from
tools/web-template/ with the example name and build stamp substituted, and every
asset root the page's code can name copied in under it.

**Two fleets, one allowlist** (web-publish.md §3a): production is the curated
face and previews are the diagnostic surface, so `--release-fleet` builds every
game plus the examples `RELEASE_EXAMPLES` names, and `--all` builds everything.
Games are in both, always, enumerated from the `games/*` glob — a new prototype
is on the production page with no configuration anywhere (ADR-0038). Only
examples are allowlisted, and `RELEASE_EXAMPLES` below is the whole allowlist:
the deploy workflow chooses a fleet, it never names what is in one.

**dist/<name>/ is repository-shaped** (ADR-0040): an asset root is staged at the
path the code names it by, so `asset_source("assets")` and
`asset_source("games/giri/assets")` fetch the same directories on the web that
they read on native. Examples load from the repository's shared `assets/`; a
game also gets its own `<crate>/assets/`, which is how a prototype's art travels
with it (ADR-0038).

Stdlib only, like every other tool here (tooling.md). The one external tool it
needs that cargo cannot provide is the `wasm-bindgen` CLI, whose version must
match the `wasm-bindgen` crate in Cargo.lock exactly — a mismatch produces glue
that fails at run time with a message about nothing in particular. This checks
for that before it can happen and says how to fix it.

The build stamp (short git sha + date) is allowed to read git and the wall
clock: the wall-clock ban covers engine and simulation code, not build scripts
(web-publish.md §1).
"""

import argparse
import json
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
TEMPLATE = REPO_ROOT / "tools" / "web-template" / "index.html"
ROOT_TEMPLATE = REPO_ROOT / "tools" / "web-template" / "root-index.html"
DIST = REPO_ROOT / "dist"
TARGET = "wasm32-unknown-unknown"

# Advisory, not a gate: the wasm size is logged on every build and warned about
# past this, so drift is visible long before it is a problem (web-publish.md §1).
WASM_WARN_BYTES = 5 * 1024 * 1024

# The oldest wasm-opt this tool will use. Ubuntu 24.04's binaryen 108 clamps
# the externref table wasm-bindgen's glue grows from JS, so every optimized
# module died at startup — "RangeError: WebAssembly.Table.grow" in every
# browser, found by playtesting PR #59's preview on three of them. version 124
# is verified good by `tools/serve-web --check`; move this pin only with a
# browser check in hand. Below it the module ships unoptimized with a log line:
# correct-but-larger beats broken (web-publish.md §1).
MIN_WASM_OPT_VERSION = 124

# Examples that are native by design: their wasm `main` is a printed stub (the
# example's own source says why, under its `cfg(target_arch = "wasm32")`), so
# there is nothing for wasm-bindgen to bind and nothing for a page to run.
# Excluded from the fleet rather than shipped as pages that cannot play; any
# OTHER bindgen failure still fails the build loudly. Keyed by name → the
# reason, printed when skipped — a silent exclusion list is how a web-runnable
# example goes quietly missing from the site.
# The crate whose examples are the playtest fleet (web-publish.md §3): the
# facade is what a game author sees, so its examples are what the site shows.
FACADE_PACKAGE = "jidousha"

NATIVE_ONLY_EXAMPLES = {
    "load_from_disk": "reads real files off a real disk (assets.md §5); "
    "its wasm build is a printed stub by design",
}

# THE ALLOWLIST (web-publish.md §3a, owner 2026-08-23). The examples the
# production page serves, and the only place this list exists — the deploy
# workflow picks a fleet by name, it never names a fleet's members.
#
# Games are deliberately absent and must stay absent: they come from the
# `games/*` glob by way of `cargo metadata`, so a new prototype is on the
# production page with no configuration anywhere (ADR-0038's no-registration
# property). A game name written here would be that property's first breach.
#
# Adding an example here is a decision about what the project's face shows, not
# a build detail: production is curated, PR previews carry the whole fleet
# because that is where engine changes get eyeballed.
RELEASE_EXAMPLES = ("pong",)

# The example the full fleet leads with (web-publish.md §3). It heads the
# examples list on the index and `fleet.txt` — on a release build that falls to
# the allowlist's first example instead, which is the point: neither the
# workflow nor this constant has to know which fleet was built.
HEADLINE_EXAMPLE = "prototype_kit"

# CONSOLE EXAMPLES: built for the web, but they never call `platform::run()`
# (web-publish.md §3a). They teach with a `World` and a `println!` —
# `headless_sim` is "a whole game, with no window", `vec2_tour` is every `Vec2`
# operation in one file — and their page is worth having because the log is the
# thing to read.
#
# Not calling `run()` decides two things about what such a page can be asked to
# prove. It never opens a surface, so a blank canvas is its correct result; and
# the forced `?panic=1` is raised *inside* `run()`, so it never fires there
# either. Both assertions hold on the nine windowed pages, which is where they
# earn their keep.
#
# Named here because `serve-web --check` cannot tell "draws nothing by design"
# from "broken" by looking, and a check that cannot tell them apart has to do
# one of two wrong things: drop the assertions for every page, or call these
# six a failure. `fleet.txt` carries the answer out to the check
# (`fleet_listing`), so the workflow still never names a page.
#
# An example that grows a window belongs out of this list in the same commit.
CONSOLE_EXAMPLES = frozenset(
    {
        "headless_sim",
        "homing",
        "loading_gate",
        "scripted_player",
        "spawn_and_reap",
        "vec2_tour",
    }
)


def fail(what: str, specifics: str, cause: str, fix: str) -> int:
    """Report in the engine's message format (core.md §9)."""
    print(f"[jidousha] {what}\n  {specifics}\n  likely cause: {cause}\n  fix: {fix}")
    return 1


def locked_wasm_bindgen_version() -> "str | None":
    """The `wasm-bindgen` version Cargo.lock pins, which the CLI must match."""
    lock = REPO_ROOT / "Cargo.lock"
    if not lock.exists():
        return None
    text = lock.read_text(encoding="utf-8")
    match = re.search(
        r'^\[\[package\]\]\nname = "wasm-bindgen"\nversion = "([^"]+)"',
        text,
        re.MULTILINE,
    )
    return match.group(1) if match else None


def installed_wasm_bindgen_version() -> "str | None":
    """The CLI's version, or `None` if it is not on PATH."""
    binary = shutil.which("wasm-bindgen")
    if binary is None:
        return None
    proc = subprocess.run(
        [binary, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
    )
    match = re.search(r"(\d+\.\d+\.\d+)", proc.stdout)
    return match.group(1) if match else None


def check_toolchain(wanted: "str | None") -> int:
    """Verify the `wasm-bindgen` CLI is present and matches the lockfile."""
    if wanted is None:
        return fail(
            "cannot tell which wasm-bindgen version this workspace needs",
            "Cargo.lock has no wasm-bindgen entry",
            "the workspace does not depend on wasm-bindgen yet, or Cargo.lock is missing",
            "run `cargo check --target wasm32-unknown-unknown` once to populate the lockfile",
        )
    found = installed_wasm_bindgen_version()
    if found is None:
        return fail(
            "the wasm-bindgen CLI is not installed",
            f"this workspace needs exactly {wanted}",
            "it is a separate tool from the crate, and cargo does not install it for you",
            f"cargo install wasm-bindgen-cli --version {wanted} --locked",
        )
    if found != wanted:
        return fail(
            f"the wasm-bindgen CLI is {found}, but this workspace needs {wanted}",
            "the CLI and the crate generate two halves of one interface",
            "a version skew, usually from a global install made for another project",
            f"cargo install wasm-bindgen-cli --version {wanted} --locked",
        )
    return 0


def run(command: "list[str]", what: str) -> int:
    """Run a build step, echoing it first."""
    print(f"[build-web] {' '.join(command)}")
    proc = subprocess.run(command, cwd=REPO_ROOT)
    if proc.returncode != 0:
        return fail(
            f"{what} failed",
            f"`{' '.join(command)}` exited {proc.returncode}",
            "the error above says which; this tool only orchestrates",
            "fix the reported error and run this again",
        )
    return 0


def parse_playables(metadata: dict, repo: Path) -> "list[tuple[str, str, str]]":
    """Everything the workspace can put on a page, as (package, name, kind).

    `example` is an example target of a workspace member; `game` is a binary of
    a workspace member under `games/` (ADR-0038). The kind decides how cargo is
    asked for it and where the module lands, and nothing else here.
    """
    members = set(metadata.get("workspace_members", []))
    games_root = str(repo / "games")
    found = []
    for package in metadata.get("packages", []):
        if package["id"] not in members:
            continue
        is_game = str(Path(package["manifest_path"]).parent).startswith(games_root)
        for target in package.get("targets", []):
            kinds = target.get("kind", [])
            if "example" in kinds:
                found.append((package["name"], target["name"], "example"))
            elif is_game and "bin" in kinds:
                found.append((package["name"], target["name"], "game"))
    return sorted(found, key=lambda entry: entry[1])


def parse_package_dirs(metadata: dict, repo: Path) -> "dict[str, str]":
    """Each workspace member's directory, relative to the repository root.

    What `stage_assets` needs to find a game's own `assets/`: a game is a crate
    (ADR-0038) and its art lives beside its manifest, so the directory cargo
    reports is the one authority on where that is. Read from the manifest rather
    than assumed to be `games/<name>/`, because a crate's directory and its
    binary's name are two different things and only one of them names the page.
    """
    members = set(metadata.get("workspace_members", []))
    dirs = {}
    for package in metadata.get("packages", []):
        if package["id"] not in members:
            continue
        directory = Path(package["manifest_path"]).parent
        try:
            dirs[package["name"]] = directory.relative_to(repo).as_posix()
        except ValueError:
            # Outside the repository: nothing here can stage it, and nothing in
            # this workspace is.
            continue
    return dirs


def workspace_metadata() -> "dict | None":
    """`cargo metadata` for this workspace, or None if cargo could not run."""
    proc = subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--no-deps"],
        cwd=REPO_ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        return None
    return json.loads(proc.stdout)


def playable_targets() -> "list[tuple[str, str, str]] | None":
    """Every (package, name, kind) the workspace defines, sorted by name."""
    metadata = workspace_metadata()
    if metadata is None:
        return None
    return parse_playables(metadata, REPO_ROOT)


def package_dirs() -> "dict[str, str]":
    """Each workspace member's repository-relative directory, or nothing."""
    metadata = workspace_metadata()
    return {} if metadata is None else parse_package_dirs(metadata, REPO_ROOT)


def own_asset_root(package: str, kind: str, dirs: "dict[str, str]") -> "str | None":
    """The asset root this playable owns, beyond the repository's shared one.

    A game's own art lives at `<its crate>/assets/` and travels with it
    (ADR-0038, ADR-0040); an example loads from the repository's shared
    `assets/` and owns nothing. `None` when there is no such directory, which is
    a game that draws shapes and text.
    """
    if kind != "game":
        return None
    directory = dirs.get(package)
    if directory is None:
        return None
    root = f"{directory}/assets"
    return root if (REPO_ROOT / root).is_dir() else None


def find_playable(name: str) -> "tuple[str, str, str] | None":
    """The package owning `name`, the name, and its kind."""
    targets = playable_targets()
    if targets is None:
        return None
    for package, playable, kind in targets:
        if playable == name:
            return (package, playable, kind)
    return None


def build_stamp() -> str:
    """Short git sha (+ `-dirty` when the tree is) and the UTC build date.

    A playtester's bug report always identifies its build (web-publish.md §1).
    `unknown` rather than a crash when git is absent: a game repo built from a
    tarball still deserves a page.
    """
    date = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    try:
        sha = subprocess.run(
            ["git", "rev-parse", "--short", "HEAD"],
            cwd=REPO_ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        ).stdout.strip()
        porcelain = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=REPO_ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        ).stdout.strip()
    except OSError:
        sha, porcelain = "", ""
    if not sha:
        return f"unknown · {date}"
    return f"{sha}{'-dirty' if porcelain else ''} · {date}"


def stage_page(out_dir: Path, example: str, stamp: str, template: Path = TEMPLATE) -> None:
    """Write the playtest page with its placeholders substituted.

    Substitution beats keeping a copy of the page per example in the repo; the
    template is the one source (web-publish.md §2).
    """
    page = template.read_text(encoding="utf-8")
    page = page.replace("__EXAMPLE__", example).replace("__BUILD_STAMP__", stamp)
    (out_dir / "index.html").write_text(page, encoding="utf-8")


def stage_one_root(out_dir: Path, root: str) -> int:
    """Copy one asset root under the page at the path the code names it by.

    Copying rather than symlinking keeps dist/ honest: what is in it is what
    ships.
    """
    source = REPO_ROOT / root
    if not source.is_dir():
        return 0
    destination = out_dir / root
    if destination.exists():
        shutil.rmtree(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, destination)
    return sum(1 for path in destination.rglob("*") if path.is_file())


def stage_assets(out_dir: Path, own_root: "str | None" = None) -> None:
    """Copy every asset root the page's code can name, the way a deploy does.

    **`dist/<name>/` is repository-shaped** (ADR-0040, web-publish.md §1a). The
    web loader (A2) fetches an asset root *relative to the page*, and the native
    loader reads it relative to the workspace root, so the two agree only if the
    directory sits under the page at the path the code names — `"assets"` for
    the repository's shared root, `"games/giri/assets"` for a game's own. One
    string, one directory, both platforms (assets.md §2 CONTRACT).

    Two roots reach a page, and which ones is not a guess:

    - the repository's shared `assets/`, which every example loads from and
      which is staged for every page;
    - the game's own `<crate>/assets/`, staged for that game's page only, so a
      prototype's art travels with it and two games' `icon_coin.png` cannot
      collide (ADR-0038, FINDINGS G-005).
    """
    staged = stage_one_root(out_dir, "assets")
    if own_root is not None:
        staged += stage_one_root(out_dir, own_root)
        print(f"[build-web] staged {own_root}/ beside the page")
    # A repository with no asset root is fine; a page whose game loads nothing
    # still runs, so zero is reported rather than refused.
    print(f"[build-web] staged {staged} asset file(s)")


def installed_wasm_opt() -> "tuple[str, int] | None":
    """The wasm-opt on PATH as (binary, version), or None. Version 0 = unparsable."""
    binary = shutil.which("wasm-opt")
    if binary is None:
        return None
    proc = subprocess.run(
        [binary, "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
    )
    match = re.search(r"version[ _](\d+)", proc.stdout)
    return (binary, int(match.group(1)) if match else 0)


def optimize(wasm: Path) -> None:
    """Shrink the module with wasm-opt when a trustworthy one is installed.

    Optional by design (web-publish.md §1): absence is a log line, never a
    failure — the unoptimized module is correct, just larger. A wasm-opt older
    than MIN_WASM_OPT_VERSION is treated as absent, loudly: an old one does not
    merely optimize less, it damages the module (see the constant).
    """
    found = installed_wasm_opt()
    if found is None:
        print("[build-web] wasm-opt not found — skipping optimization (optional; binaryen provides it)")
        return
    binary, version = found
    if version < MIN_WASM_OPT_VERSION:
        print(
            f"[build-web] wasm-opt {version or '(unknown version)'} is older than "
            f"{MIN_WASM_OPT_VERSION} — skipping optimization: binaryen 108 clamps the "
            "externref table and every optimized module dies at startup in every "
            "browser (web-publish.md §5); the unoptimized module is correct"
        )
        return
    optimized = wasm.with_suffix(".wasm.opt")
    proc = subprocess.run([binary, "-Os", str(wasm), "-o", str(optimized)])
    if proc.returncode != 0:
        # Correct-but-larger beats broken: report and ship the unoptimized one.
        print(f"[build-web] wasm-opt exited {proc.returncode} — shipping the unoptimized module")
        if optimized.exists():
            optimized.unlink()
        return
    before, after = wasm.stat().st_size, optimized.stat().st_size
    optimized.replace(wasm)
    print(f"[build-web] wasm-opt -Os: {before / 1e6:.2f} MB → {after / 1e6:.2f} MB")


def report_size(wasm: Path) -> None:
    """Log the shipped module size; warn past the drift line (never fail)."""
    size = wasm.stat().st_size
    print(f"[build-web] {wasm.relative_to(REPO_ROOT)} is {size / 1e6:.2f} MB")
    if size > WASM_WARN_BYTES:
        print(
            f"[build-web] WARNING: over {WASM_WARN_BYTES // (1024 * 1024)} MB — "
            "not a failure, but worth knowing what grew (web-publish.md §1)"
        )


def compile_playables(package: str, names: "list[str]", kind: str, debug: bool) -> int:
    """One cargo invocation for every requested target of one package.

    A game's binary needs no selector — the crate is the game — where an example
    is picked out of its crate by name.
    """
    command = ["cargo", "build", "--target", TARGET, "-p", package]
    if kind == "example":
        for name in names:
            command += ["--example", name]
    if not debug:
        command.append("--release")
    return run(command, "the wasm build")


def module_path(name: str, kind: str, debug: bool) -> Path:
    """Where cargo leaves the wasm module for one playable.

    Examples land in an `examples/` subdirectory of the profile directory;
    binaries land in the profile directory itself. The only place this
    distinction reaches.
    """
    profile = REPO_ROOT / "target" / TARGET / ("debug" if debug else "release")
    directory = profile / "examples" if kind == "example" else profile
    return directory / f"{name}.wasm"


def stage_playable(
    name: str, kind: str, debug: bool, stamp: str, own_root: "str | None" = None
) -> int:
    """Bind, optimize, and stage one already-compiled playable under dist/<name>/."""
    wasm = module_path(name, kind, debug)
    if not wasm.exists():
        return fail(
            "the wasm build produced no module",
            f"expected {wasm.relative_to(REPO_ROOT)}",
            "it built for a different profile, or cargo changed its output layout",
            "check the build output above for where the artifact went",
        )

    out_dir = DIST / name
    out_dir.mkdir(parents=True, exist_ok=True)
    step = run(
        [
            "wasm-bindgen",
            "--target",
            "web",
            "--no-typescript",
            "--out-dir",
            str(out_dir),
            "--out-name",
            name,
            str(wasm),
        ],
        "wasm-bindgen",
    )
    if step != 0:
        return step

    module = out_dir / f"{name}_bg.wasm"
    optimize(module)
    report_size(module)

    if not TEMPLATE.exists():
        return fail(
            "the playtest page template is missing",
            f"expected {TEMPLATE.relative_to(REPO_ROOT)}",
            "the checkout is incomplete, or the template was moved without updating this tool",
            "restore tools/web-template/index.html",
        )
    stage_page(out_dir, name, stamp)
    stage_assets(out_dir, own_root)
    print(f"[build-web] built {out_dir.relative_to(REPO_ROOT)}/ — serve it with `tools/serve-web {name}`")
    return 0


def build(package: str, name: str, kind: str, debug: bool) -> int:
    """Compile, bind, optimize, and stage one playable under dist/<name>/."""
    step = compile_playables(package, [name], kind, debug)
    if step != 0:
        return step
    own_root = own_asset_root(package, kind, package_dirs())
    return stage_playable(name, kind, debug, build_stamp(), own_root)


def ordered_names(names: "list[str]", headline: "str | None" = None) -> "list[str]":
    """`names` sorted, with `headline` pulled to the front when it is present.

    One ordering for the index and for `fleet.txt`, so the page's first link and
    the fleet listing's first line are the same page.
    """
    return sorted(names, key=lambda name: (name != headline, name))


def root_index_items(names: "list[str]", headline: "str | None" = None) -> str:
    """One section's list, `headline` first when the section has one.

    `prototype_kit` leads the examples on the full fleet (web-publish.md §3);
    games are listed in the order they sort, because no prototype is the
    headline of the others.
    """
    lines = []
    for name in ordered_names(names, headline):
        marker = ' class="headline"' if name == headline else ""
        lines.append(f'<li{marker}><a href="{name}/">{name}</a></li>')
    return "\n        ".join(lines)


def root_index_section(
    heading: str, blurb: str, names: "list[str]", headline: "str | None" = None
) -> str:
    """One heading, one blurb and one list — or nothing when the section is empty.

    An empty section is omitted whole rather than left as a heading over an
    empty list: `games/` can be empty (ADR-0038), and so can an allowlist.
    """
    if not names:
        return ""
    return (
        f"\n      <h2>{heading}</h2>\n"
        f"      <p>{blurb}</p>\n"
        "      <ul>\n        "
        + root_index_items(names, headline)
        + "\n      </ul>\n"
    )


def root_index_sections(examples: "list[str]", games: "list[str]", release: bool) -> str:
    """The body of the root index: two sections, ordered by what this build is for.

    The production page leads with **games** — the prototypes are the thing to
    play — and follows with the **worked example** the allowlist keeps beside
    them (web-publish.md §3a). A preview page keeps the shape it has always had:
    the whole example fleet first, headline first, then the games. Previews are
    read by whoever is reviewing an engine change, and the examples are what
    that change shows up in.
    """
    games_section = root_index_section(
        "games",
        "prototypes built with the engine — one crate each, under <code>games/</code>",
        games,
    )
    if release:
        return games_section + root_index_section(
            "worked example",
            "the engine's own example the production page keeps playable — every "
            "other example lives on the PR previews",
            examples,
        )
    return (
        root_index_section(
            "examples",
            "every example of the engine, built for the web — pick one to play",
            examples,
            headline=HEADLINE_EXAMPLE,
        )
        + games_section
    )


def fleet_listing(examples: "list[str]", games: "list[str]") -> str:
    """Every page this build produced, one per line, the index's first link first.

    Two columns: the page, and what it has to prove — `windowed` for a page
    that goes through `platform::run()`, `console` for one of
    `CONSOLE_EXAMPLES`, which does not. That one word decides two assertions:
    only a windowed page has a canvas that must show something, and only a
    windowed page reaches the forced `?panic=1` (it is raised inside `run()`).
    Written to `dist/fleet.txt`, which `serve-web --check`
    reads (web-publish.md §4). The check thereby follows whichever fleet was
    built instead of naming a member of one — the release fleet has no
    `sprites` to check, and no workflow should have to know that.

    Games are always `windowed`: a prototype nobody can see is not a prototype,
    and ADR-0038's no-registration property means a new one must get the
    stricter assertion without anybody adding it to a list.
    """
    listed = [(name, name in CONSOLE_EXAMPLES) for name in ordered_names(examples, HEADLINE_EXAMPLE)]
    # Games are appended as windowed without consulting the set at all: the set
    # names *examples*, and a game that happened to share a name with one must
    # not inherit its weaker assertions.
    listed += [(name, False) for name in sorted(games)]
    return "".join(f"{name} {'console' if console else 'windowed'}\n" for name, console in listed)


def stage_root_index(
    examples: "list[str]", games: "list[str]", stamp: str, release: bool = False
) -> int:
    """Write the dist/ root: the index page, the stamp file and the fleet listing.

    `stamp.txt` exists so the deploy workflow can put the exact stamp the pages
    carry into its PR comment without re-deriving it; `fleet.txt` so it can
    browser-check a page that is certainly there (web-publish.md §4).
    """
    if not ROOT_TEMPLATE.exists():
        return fail(
            "the root index template is missing",
            f"expected {ROOT_TEMPLATE.relative_to(REPO_ROOT)}",
            "the checkout is incomplete, or the template was moved without updating this tool",
            "restore tools/web-template/root-index.html",
        )
    page = ROOT_TEMPLATE.read_text(encoding="utf-8")
    page = page.replace("__SECTIONS__", root_index_sections(examples, games, release))
    page = page.replace("__BUILD_STAMP__", stamp)
    (DIST / "index.html").write_text(page, encoding="utf-8")
    (DIST / "stamp.txt").write_text(stamp + "\n", encoding="utf-8")
    (DIST / "fleet.txt").write_text(fleet_listing(examples, games), encoding="utf-8")
    print(
        f"[build-web] wrote dist/index.html listing {len(examples)} example(s) "
        f"and {len(games)} game(s) — the "
        f"{'release' if release else 'full'} fleet"
    )
    return 0


def prune_stale(names: "list[str]") -> None:
    """Remove dist/ subdirectories that no longer name an example or a game.

    dist/ is what deploys, verbatim — a renamed example, or a prototype moved to
    `attic/`, must not leave its old self playable on the site.
    """
    keep = set(names)
    for entry in DIST.iterdir():
        if entry.is_dir() and entry.name not in keep:
            shutil.rmtree(entry)
            print(f"[build-web] pruned stale dist/{entry.name}/ (no such example or game)")


def fleet(
    targets: "list[tuple[str, str, str]]", release: bool = False
) -> "tuple[list[str], list[str]]":
    """The examples and the games that get pages, from everything the workspace has.

    The example half is the facade crate's — what a game author sees and what
    docs/api/ points at (`cargo run -p jidousha --example <name>`). Internal
    crates' examples (render-core's headless demos, platform's `window_blank`)
    are engine documentation, not playtest material, and some never touch the JS
    boundary at all. The game half is every prototype: a game exists to be
    played, and a playtest URL on the first push is most of why it lives here
    (ADR-0038).

    `release` narrows the *examples* to `RELEASE_EXAMPLES` and nothing else
    (web-publish.md §3a). The game half is identical in both fleets, because the
    production page is where a prototype is played and the glob is the only
    thing that decides what is on it.

    Every exclusion is printed. A silent one is how a web-runnable example goes
    quietly missing from the site.
    """
    examples, games = [], []
    for package, name, kind in targets:
        if kind == "game":
            games.append(name)
            continue
        if package != FACADE_PACKAGE:
            print(f"[build-web] skipping {name}: an internal {package} example, not the facade's")
            continue
        if name in NATIVE_ONLY_EXAMPLES:
            print(f"[build-web] skipping {name}: {NATIVE_ONLY_EXAMPLES[name]}")
            continue
        if release and name not in RELEASE_EXAMPLES:
            print(
                f"[build-web] skipping {name}: not on the release fleet's example "
                "allowlist — it plays on PR previews (web-publish.md §3a)"
            )
            continue
        examples.append(name)
    return sorted(examples), sorted(games)


def missing_from_allowlist(examples: "list[str]") -> "list[str]":
    """Allowlist entries the workspace did not produce a page for.

    The allowlist must rot loudly, like `NATIVE_ONLY_EXAMPLES`: an entry naming
    a renamed, deleted or native-only example would quietly shrink the
    production page instead of failing the build that shrank it.
    """
    return [name for name in RELEASE_EXAMPLES if name not in examples]


def build_all(targets: "list[tuple[str, str, str]]", debug: bool, release: bool = False) -> int:
    """The engine-repo deploy layout: a whole fleet of pages, plus the index.

    `release` builds the production fleet — every game, plus the allowlisted
    examples — where the default builds everything a PR preview shows
    (web-publish.md §3a). One code path either way: the fleets differ in what
    `fleet()` returns and in nothing else.
    """
    examples, games = fleet(targets, release)
    if release:
        missing = missing_from_allowlist(examples)
        if missing:
            return fail(
                "the release fleet's example allowlist names something this "
                "workspace cannot put on a page",
                f"no web-buildable facade example named {', '.join(missing)}",
                "an example was renamed, deleted, or became native-only, and the "
                "allowlist was not updated with it",
                "fix RELEASE_EXAMPLES in tools/build-web — it is the one place "
                "the allowlist lives (web-publish.md §3a)",
            )
    package_of = {name: package for package, name, _kind in targets}

    # One cargo invocation per (package, kind): the facade's examples together,
    # then each game's own crate.
    if examples:
        step = compile_playables(FACADE_PACKAGE, examples, "example", debug)
        if step != 0:
            return step
    for name in games:
        step = compile_playables(package_of[name], [name], "game", debug)
        if step != 0:
            return step

    stamp = build_stamp()
    dirs = package_dirs()
    for name in examples:
        step = stage_playable(name, "example", debug, stamp)
        if step != 0:
            return step
    for name in games:
        own_root = own_asset_root(package_of[name], "game", dirs)
        step = stage_playable(name, "game", debug, stamp, own_root)
        if step != 0:
            return step
    prune_stale(examples + games)
    return stage_root_index(examples, games, stamp, release)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", help="the example or game to build, e.g. sprites")
    parser.add_argument(
        "--all",
        action="store_true",
        help="build the full fleet — every example and game, plus the root index "
        "page — which is what PR previews deploy (web-publish.md §3)",
    )
    parser.add_argument(
        "--release-fleet",
        action="store_true",
        help="build the release fleet — every game plus the allowlisted examples "
        "— which is what the production deploy serves (web-publish.md §3a)",
    )
    parser.add_argument(
        "--debug",
        action="store_true",
        help="build the debug profile (default is release: what ships is what gets tested)",
    )
    args = parser.parse_args()
    if [bool(args.name), args.all, args.release_fleet].count(True) != 1:
        return fail(
            "this tool builds one named example or game, or one whole fleet — "
            "exactly one of a name, --all and --release-fleet",
            f"name={args.name!r}, all={args.all}, release_fleet={args.release_fleet}",
            "a missing argument, or two ways of saying what to build at once",
            "run `tools/build-web <name>`, `tools/build-web --all` (the preview "
            "fleet) or `tools/build-web --release-fleet` (the production fleet)",
        )

    step = check_toolchain(locked_wasm_bindgen_version())
    if step != 0:
        return step

    if args.all or args.release_fleet:
        targets = playable_targets()
        if not targets:
            return fail(
                "nothing to build",
                "cargo metadata listed no example or game targets in the workspace",
                "cargo failed above, or the workspace really has neither",
                "run `cargo metadata` by hand and read its error",
            )
        return build_all(targets, args.debug, args.release_fleet)

    if args.name in NATIVE_ONLY_EXAMPLES:
        return fail(
            f"{args.name} is native by design and has no web build",
            NATIVE_ONLY_EXAMPLES[args.name],
            "its wasm main is a printed stub, so wasm-bindgen has nothing to bind",
            f"run it natively: cargo run -p jidousha --example {args.name}",
        )
    found = find_playable(args.name)
    if found is None:
        return fail(
            f"no example or game named {args.name!r}",
            "the workspace defines no example target and no game with that name",
            "a typo, or it lives outside this workspace",
            "run `tools/verify --list` for every name this repo can run",
        )
    package, name, kind = found
    return build(package, name, kind, args.debug)


if __name__ == "__main__":
    sys.exit(main())
