#!/usr/bin/env python3
"""Serve a web build from dist/, the way a deploy would.

The local half of the publish pipeline (web-publish.md §1): `tools/build-web`
writes dist/<name>/, this serves dist/ — a static server and nothing else, so
what works here is what works deployed. It MUST serve `.wasm` as
`application/wasm` (doctor verifies that by fetching one).

    tools/serve-web sprites             # serve dist/, open at /sprites/
    tools/serve-web                     # serve dist/ as a whole
    tools/serve-web sprites --check     # drive a headless browser at the page,
                                        # then at the forced panic (?panic=1),
                                        # then at ?frametime=1, report, exit
    tools/serve-web --check             # the same, over every page this build
                                        # contains (dist/fleet.txt) — what CI runs

`--check` is what makes the web target *checkable* rather than merely
compilable: it loads the page in a real Chromium, asserts the module started
and drew, loads it again with `?panic=1` and asserts the panic overlay rendered
the full §9 message, and loads it a third time with `?frametime=1` and asserts
the frame-pacing overlay came up, classified the renderer and reached a measured
verdict on how this browser presents (web-publish.md §2, §6 W0 exit criteria).
Given no page it runs that over the **whole build**, because a check that covers
only one page of a fleet leaves the rest able to reach production unexamined
(web-publish.md §3a).
The first pass also asserts the page's half of touch — `touch-action: none` on
the canvas (web-publish.md §2a) — which is a grep, because this browser has no
fingers and the tap itself is a person's job.

The third pass has a property the other two do not: this browser is *deliberately*
software-rendering — `--use-angle=swiftshader`, because a CI runner has no GPU —
so the overlay's software-rendering warning is a thing the check can require
rather than merely tolerate, and a detector that stopped detecting fails here.

Stdlib only, like every other tool here (tooling.md).
"""

import argparse
import http.server
import os
import re
import shutil
import socketserver
import struct
import subprocess
import sys
import threading
import time
import zlib
from pathlib import Path

# Line-buffered from the first print, because the interesting failure is a
# *hang*: a pipe is block-buffered by default, so on a run that times out CI
# shows nothing until the process exits and the whole log lands at once, with
# every line carrying the same timestamp. That is what made three consecutive
# 120s failures unreadable — the log could not say how far the check had got.
sys.stdout.reconfigure(line_buffering=True)

REPO_ROOT = Path(__file__).resolve().parents[1]
DIST = REPO_ROOT / "dist"
# The check's working files (browser profile, log, screenshots) live outside
# dist/ — dist/ is what deploys, and a deploy must not carry a browser log.
CHECK_DIR = REPO_ROOT / "target" / "web-check"

# How much *page* time the headless check lets run before dumping the DOM.
#
# Small on purpose, and 4x smaller since it was measured. The engine draws
# every frame, so page time is spent at whatever rate the software rasterizer
# manages — and that rate is *noisy*, so the cost of a budget is not merely
# high but unpredictable. Measured on `pong` in this project's container, four
# runs each:
#
#     budget   wall time        what the check reads
#      500ms   2.5 - 2.6s       every marker; pacing verdict only "sampling"
#     1000ms   3.1 - 3.9s       every marker; pacing verdict "ok"
#     2000ms   9.4 - 13.9s      same
#     4000ms   11.6 - 18.1s     same
#
# Nothing above 1000ms buys a single additional assertion. It buys spread: the
# same page, the same commit, the same machine ran the `run` pass in 7.5s and
# in 30.4s at the old budget, and a CI runner sharing its cores has a longer
# tail than that — which is how a page that was fine ran into `CHECK_TIMEOUT_S`
# and reported itself as a hang (jidousha#80's merge, 2026-09-01).
#
# 1000ms rather than 500ms because at 500ms the frame-pacing classifier has not
# seen its 60 frames and reports "sampling": the check accepts that, but a
# detector that never reaches a verdict is a detector nothing is testing.
CHECK_VIRTUAL_MS = 1000
# The wall-clock ceiling on the browser itself, which is a different question
# from how much page time it simulates. With the budget above it is roughly 30x
# the check's actual cost, which is the point: this ceiling should mean "the
# page is broken", never "the runner was busy".
CHECK_TIMEOUT_S = 120
# How many lines of the browser's own stderr to quote when it hangs.
#
# The log is written to `target/web-check/` either way, but a CI run whose
# artifacts are not collected has only what was printed — so the tail goes into
# the output too. Forty lines is enough to carry a stack, a GPU-process death or
# a repeated warning, and short enough not to bury the §9 message above it.
HUNG_LOG_LINES = 40


def fail(what: str, specifics: str, cause: str, fix: str) -> int:
    """Report in the engine's message format (core.md §9)."""
    print(f"[jidousha] {what}\n  {specifics}\n  likely cause: {cause}\n  fix: {fix}")
    return 1


def handler_for(directory: Path):
    """A request handler class serving `directory` with correct wasm MIME.

    A factory rather than a module-level class so doctor's MIME self-check can
    stand one up over a scratch directory (web-publish.md §5).
    """

    class Handler(http.server.SimpleHTTPRequestHandler):
        """A static server that says as little as possible."""

        # A connection that opens and then says nothing is reaped rather than
        # waited on forever. Chrome preconnects: it opens sockets it may never
        # send a request on, and the stdlib handler otherwise blocks in
        # `handle_one_request` reading one of them with no timeout at all. Ten
        # seconds is far longer than a real request off the loopback takes and
        # far shorter than the check's own wall (`CHECK_TIMEOUT_S`).
        timeout = 10

        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(directory), **kwargs)

        def log_message(self, format, *args):  # noqa: A002 - stdlib signature
            # One line per request would bury the output; failures still show
            # through the browser and through --check.
            pass

        def guess_type(self, path):
            """Serve wasm as `application/wasm`.

            Overriding the guess rather than adding a header in `end_headers`:
            the base class has already sent a Content-Type by then, and a second
            one is ignored. The symptom is a browser warning about falling back
            from `instantiateStreaming` — mild, and a lie about what is wrong.
            """
            if str(path).endswith(".wasm"):
                return "application/wasm"
            return super().guess_type(path)

    return Handler


class Server(socketserver.ThreadingTCPServer):
    """One connection may not hold up another.

    Threaded, and this is the second half of the hang fix — not a scalability
    nicety for a server with one client. `socketserver.TCPServer` handles
    connections strictly one at a time, and a browser is not one request at a
    time: Chrome opens several sockets at once and preconnects sockets it may
    never use. A single silent socket parked at the front of that queue blocks
    every real fetch behind it, which is reproducible in one line — connect,
    send nothing, and the next fetch never returns.

    That is the shape of the CI hang. `--virtual-time-budget` does not expire
    while a fetch is pending, so the wedged server stalled the page's own module
    fetch, virtual time stopped, the DOM was never dumped, and the browser sat
    silent to the 120s wall with nothing in its log to say why.
    """

    daemon_threads = True
    allow_reuse_address = True


def serve(port: int, directory: Path) -> socketserver.TCPServer:
    """Start the static server on a background thread."""
    server = Server(("127.0.0.1", port), handler_for(directory))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def decode_png(data: bytes) -> "tuple[int, int, list[tuple[int, int, int]]] | None":
    """Decode a non-interlaced 8-bit RGB/RGBA PNG into rows of pixels.

    Hand-written for the same reason the input codec is (ADR-0014): `zlib` is
    stdlib, the format's un-filtering is forty lines, and the alternative is a
    dependency for a tool that exists to check one screenshot.
    """
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    width = height = depth = color = None
    idat = bytearray()
    at = 8
    while at + 8 <= len(data):
        (length,) = struct.unpack(">I", data[at : at + 4])
        kind = data[at + 4 : at + 8]
        body = data[at + 8 : at + 8 + length]
        at += 12 + length  # 4 length + 4 kind + body + 4 crc
        if kind == b"IHDR":
            width, height, depth, color = struct.unpack(">IIBB", body[:10])
            if body[12] != 0:  # interlaced
                return None
        elif kind == b"IDAT":
            idat += body
        elif kind == b"IEND":
            break
    if width is None or depth != 8 or color not in (2, 6):
        return None

    channels = 3 if color == 2 else 4
    stride = width * channels
    raw = zlib.decompress(bytes(idat))
    pixels: "list[tuple[int, int, int]]" = []
    previous = bytearray(stride)
    at = 0
    for _ in range(height):
        filter_kind = raw[at]
        at += 1
        line = bytearray(raw[at : at + stride])
        at += stride
        for index in range(stride):
            left = line[index - channels] if index >= channels else 0
            up = previous[index]
            up_left = previous[index - channels] if index >= channels else 0
            if filter_kind == 1:
                line[index] = (line[index] + left) & 0xFF
            elif filter_kind == 2:
                line[index] = (line[index] + up) & 0xFF
            elif filter_kind == 3:
                line[index] = (line[index] + (left + up) // 2) & 0xFF
            elif filter_kind == 4:
                estimate = left + up - up_left
                distances = (
                    abs(estimate - left),
                    abs(estimate - up),
                    abs(estimate - up_left),
                )
                nearest = (left, up, up_left)[distances.index(min(distances))]
                line[index] = (line[index] + nearest) & 0xFF
        previous = line
        for x in range(width):
            base = x * channels
            pixels.append((line[base], line[base + 1], line[base + 2]))
    return (width, height, pixels)


def canvas_is_drawn(png: bytes) -> "tuple[bool, str]":
    """Whether the engine put a color on the canvas.

    Samples the lower two thirds of the page — the status line is at the top and
    the canvas fills the rest — and accepts either of two pieces of evidence:

    1. **Most of it differs from the page's own background.** An example that
       clears to a color of its own looks like this, and it is what
       `window_clear` and `sprites` show.
    2. **It is not one flat color.** An example whose clear color happens to sit
       near the page's background is invisible to the first test — `input_echo`
       clears to rgb(15, 18, 26) against a page of rgb(16, 16, 20) — but if it
       drew anything at all there is more than one color up there.

    Either is enough, because a blank canvas satisfies neither: it is the page
    background, uniformly. The second rule was added after the first one failed
    a working example, which is the failure mode a single heuristic invites.

    Deliberately not a golden image: what is being checked is "the engine drew",
    not "it drew exactly this", and an example's colors move with simulated time.
    """
    decoded = decode_png(png)
    if decoded is None:
        return (False, "the screenshot could not be decoded")
    width, height, pixels = decoded
    # The page background, from tools/web-template/index.html.
    background = (0x10, 0x10, 0x14)
    matched = 0
    total = 0
    sampled: "dict[tuple[int, int, int], int]" = {}
    for y in range(height // 3, height, max(1, height // 40)):
        for x in range(0, width, max(1, width // 40)):
            pixel = pixels[y * width + x]
            total += 1
            sampled[pixel] = sampled.get(pixel, 0) + 1
            if max(abs(a - b) for a, b in zip(pixel, background)) > 12:
                matched += 1
    if total == 0:
        return (False, "the screenshot had nothing to sample")
    share = matched / total
    common = max(sampled.items(), key=lambda item: item[1])[0]
    # How much of the canvas is *not* its own commonest color. A blank page is
    # entirely one color; anything drawn on top of a clear is not.
    drawn_on = 1.0 - sampled[common] / total
    detail = (
        f"{share:.0%} of the canvas differs from the page background, "
        f"{drawn_on:.0%} from its own commonest pixel rgb{common}"
    )
    # Half is generous for the first rule: the canvas does not fill the whole
    # sampled region at every window size. The second is deliberately small —
    # a readout in one corner is a few percent of the page, and a blank canvas
    # is zero.
    return (share > 0.5 or drawn_on > 0.005, detail)


def chromium() -> "str | None":
    """A headless-capable Chromium, if this machine has one."""
    for candidate in (
        os.environ.get("JIDOUSHA_CHROMIUM"),
        "/opt/pw-browsers/chromium-1194/chrome-linux/chrome",
        shutil.which("chromium"),
        shutil.which("chromium-browser"),
        shutil.which("google-chrome"),
    ):
        if candidate and Path(candidate).exists():
            return candidate
    # A glob, so a browser update does not silently disable the check.
    for path in sorted(Path("/opt/pw-browsers").glob("chromium-*/chrome-linux/chrome")):
        return str(path)
    return None


def load_page(
    browser: str, url: str, example: str, tag: str
) -> "tuple[str, Path, Path] | int":
    """Drive the headless browser at `url`; (dom, screenshot, log) or exit code.

    Artifacts land in `target/web-check/<example>/`, a directory per page. The
    check runs over a whole fleet, so the second page must not overwrite the
    first page's evidence: when several pages fail, every one of their logs has
    to survive to the artifact upload, or the fleet check answers "something is
    broken" without saying what.
    """
    directory = CHECK_DIR / example
    directory.mkdir(parents=True, exist_ok=True)
    profile = directory / f"profile-{tag}"
    log = directory / f"browser-{tag}.log"
    shot = directory / f"check-{tag}.png"
    command = [
        browser,
        "--headless=new",
        "--no-sandbox",
        "--disable-gpu-sandbox",
        # Software rasterization: there is no GPU on a CI runner or in a
        # container, and WebGL over SwiftShader is exactly the WebGL2 path
        # ADR-0003 §4 keeps viable. It is ANGLE that provides it — asking for
        # `--use-gl=swiftshader` gets "Requested GL implementation not found"
        # and a GPU process that exits during initialization.
        "--enable-unsafe-swiftshader",
        "--use-angle=swiftshader",
        # Chrome's own background services, off. One of two pending-fetch
        # sources behind the hang — `Server` above is the other, and the one
        # that survived these flags. `--virtual-time-budget` does not expire
        # while a network request is pending, and a stock Chrome keeps making
        # them:
        # measured on a CI runner (jidousha#81, 2026-09-01), the page finished
        # its whole job in 1.5s — module up, overlay on, renderer classified —
        # and the browser then sat for the remaining 118s retrying a GCM
        # registration against a deprecated endpoint on a backoff (+0s, +24s,
        # +66s) and never dumped the DOM. The check timed out on a page that was
        # already done.
        #
        # That is also why it was intermittent, and why no container here could
        # reproduce it: where the request fails fast — an egress-blocked
        # sandbox, say — nothing stays pending, virtual time expires and the
        # page dumps. Where it reaches Google and retries, it does not.
        "--disable-background-networking",
        # And nothing else may reach the network either. The flag above stops
        # the traffic CI caught in the act; this stops the *class*, because
        # chasing Chrome's subsystems one at a time is a losing game — with
        # background networking off, this container still logged 51 TLS
        # handshake retries from something else, and the hang persisted.
        # Resolving every name but the loopback to NOTFOUND makes such a
        # request fail instantly instead of sitting pending, which is the only
        # property that matters here. The page under test is served from
        # 127.0.0.1 and is untouched.
        "--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE 127.0.0.1",
        "--enable-logging=stderr",
        "--v=0",
        f"--user-data-dir={profile}",
        f"--virtual-time-budget={CHECK_VIRTUAL_MS}",
        "--window-size=640,480",
        f"--screenshot={shot}",
        "--dump-dom",
        url,
    ]
    # Announced before the browser starts, not after it returns: a pass that
    # hangs has to name itself, and the only output a hung run produces is what
    # was printed before it stopped.
    print(f"[serve-web] pass {tag}: {url}")
    started = time.monotonic()
    try:
        proc = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=CHECK_TIMEOUT_S,
        )
    except subprocess.TimeoutExpired as expired:
        # Whatever the browser managed to say before the wall. `TimeoutExpired`
        # carries the output captured so far, and this is the one path where it
        # is the entire evidence — the success path below writes the log, so
        # before this a hung run left no log at all.
        partial = expired.stderr or ""
        if isinstance(partial, bytes):
            partial = partial.decode("utf-8", "replace")
        log.write_text(partial, encoding="utf-8")
        lines = partial.splitlines()
        print(f"[serve-web] pass {tag} hung; browser said {len(lines)} line(s):")
        for line in lines[-HUNG_LOG_LINES:]:
            print(f"  | {line}")
        if not lines:
            print("  | (nothing — it never reached its own logging)")
        return fail(
            f"the headless browser did not finish pass {tag}",
            f"it ran for {CHECK_TIMEOUT_S}s at {url} without dumping the page; "
            f"its log is {log.relative_to(REPO_ROOT)} and the quote above is its tail",
            "a software rasterizer spending virtual time on every frame, a hung "
            "module, or a browser that hangs headless on this machine — the log "
            "above is what tells the three apart",
            "read the quoted log; the CI job uploads target/web-check/ on failure. "
            "Then either fix what it names, or run without --check and look at the "
            "page yourself",
        )
    elapsed = time.monotonic() - started
    log.write_text(proc.stderr, encoding="utf-8")
    print(f"[serve-web] browser finished in {elapsed:.1f}s; log: {log.relative_to(REPO_ROOT)}")
    return (proc.stdout, shot, log)


def page_state(dom: str) -> "tuple[str, str, bool]":
    """The page's own account of itself: (state, status text, status failed)."""
    state = "unknown"
    for candidate in ("running", "failed", "panicked"):
        if f'data-jidousha="{candidate}"' in dom:
            state = candidate
    status = re.search(r'<div id="status"([^>]*)>(.*?)</div>', dom, re.S)
    message = (status.group(2).strip() if status else "").replace("\n", " ")
    # The page styles its status line `failed` for a real failure and leaves it
    # alone for the engine's own §9 reports, which are handled problems — a
    # missing asset draws a placeholder and the game carries on. A page that
    # started and *then* said it failed used to pass this check silently.
    page_failed = "failed" in (status.group(1) if status else "")
    return (state, message, page_failed)


def check_runs(browser: str, port: int, example: str, windowed: bool = True) -> int:
    """The page loads, the module starts, and — when it is a drawing page — the
    engine draws.

    `windowed` comes from `dist/fleet.txt`, which `build-web` wrote: six of the
    engine's examples teach with a `World` and a `println!` and never call
    `platform::run()` (`CONSOLE_EXAMPLES`), so a blank canvas is their correct
    result. Passed in rather than decided here, because the check must never be
    the thing that decides a blank page is acceptable — that is the fleet's
    statement about the page, and it is made in one place.
    """
    loaded = load_page(
        browser, f"http://127.0.0.1:{port}/{example}/index.html", example, "run"
    )
    if isinstance(loaded, int):
        return loaded
    dom, shot, log = loaded
    state, message, page_failed = page_state(dom)
    print(f"[serve-web] page state: {state}")
    if message:
        print(f"[serve-web] page said: {message}")

    if state == "running" and page_failed:
        return fail(
            f"{example} started and then reported a failure",
            message or "(the page gave no message)",
            "the module loaded and something threw afterwards — a panic, or a "
            "failed import inside the page",
            f"read {log.relative_to(REPO_ROOT)} and the message above",
        )

    if state != "running":
        return fail(
            f"{example} did not start in the browser",
            f"page state: {state}; page said: {message or '(nothing)'}",
            "the wasm module failed to load or panicked on startup; the browser log has the detail",
            f"read {log.relative_to(REPO_ROOT)}, then run without --check and open the page yourself",
        )

    # Starting is not drawing. Checking the pixels is what makes this a
    # verification rather than a smoke test — and it is not hypothetical:
    # the WebGPU-with-no-fallback bug this tool found on its first run
    # produced a page that started perfectly and drew nothing.
    if not shot.exists():
        return fail(
            f"{example} started but produced no screenshot",
            f"expected {shot.relative_to(REPO_ROOT)}",
            "the browser exited before compositing a frame",
            "raise CHECK_VIRTUAL_MS, or run without --check and look yourself",
        )
    drawn, detail = canvas_is_drawn(shot.read_bytes())
    print(f"[serve-web] {detail}")
    if not windowed:
        # Said out loud every time, never inferred from a blank result: the one
        # way this weaker assertion could hurt is by going unnoticed on a page
        # that was supposed to draw.
        print(
            f"[serve-web] PASS — {example} started in a browser "
            "(a console example: the fleet says it opens no window)"
        )
        return check_touch_rules(dom, example)
    if not drawn:
        return fail(
            f"{example} started but drew nothing",
            detail,
            "the engine got no GPU adapter, or the surface is not the canvas on "
            "the page — or the page never calls platform::run() and "
            "tools/build-web's CONSOLE_EXAMPLES has not been told",
            f"look at {shot.relative_to(REPO_ROOT)} and {log.relative_to(REPO_ROOT)}",
        )
    print(f"[serve-web] PASS — {example} started and drew in a browser")

    return check_touch_rules(dom, example)


def check_touch_rules(dom: str, example: str) -> int:
    """The page's half of touch is still on the page (web-publish.md §2a).

    A grep, and deliberately so. What a *person* has to check — that a tap
    lands where the finger is and lands once — needs a finger, and this
    browser has none: Chromium is driven here by command-line flags, with no
    channel to dispatch input, and a synthetic touch dispatched by a page
    script produces none of the compatibility mouse events the real thing
    does. So the last mile stays a person with a phone (input.md §3a), and
    what CI can hold onto is that the rule which cannot be fixed engine-side
    is present: without `touch-action: none` the browser takes the gesture
    and the drag becomes a page scroll, whatever the engine does about it.
    """
    canvas_rule = re.search(r"\bcanvas\s*\{(.*?)\}", dom, re.S)
    if canvas_rule is None or "touch-action: none" not in canvas_rule.group(1):
        return fail(
            f"{example}'s canvas does not say `touch-action: none`",
            "the page shell's canvas rule is missing it, or there is no canvas rule",
            "tools/web-template/index.html lost the line, or the page was built "
            "from a template that never had it",
            "restore `touch-action: none` on the canvas — without it a drag "
            "scrolls the page and the browser cancels the touch mid-gesture "
            "(web-publish.md §2a)",
        )
    print("[serve-web] PASS — the canvas leaves touch to the engine (touch-action: none)")
    return 0


def check_panic_overlay(browser: str, port: int, example: str) -> int:
    """The forced panic (?panic=1) renders the overlay with the §9 text.

    The overlay is a CONTRACT (web-publish.md §2): remote playtesters do not
    open devtools, so a panic that is console-only is a panic nobody reports.
    This is the W0 exit criterion made repeatable — the same check a person
    does by adding ?panic=1 to any deployed build's URL.
    """
    loaded = load_page(
        browser,
        f"http://127.0.0.1:{port}/{example}/index.html?panic=1",
        example,
        "panic",
    )
    if isinstance(loaded, int):
        return loaded
    dom, _shot, log = loaded
    state, _message, _failed = page_state(dom)
    print(f"[serve-web] page state with ?panic=1: {state}")
    if state != "panicked":
        return fail(
            f"{example} with ?panic=1 did not reach the panic overlay",
            f"page state: {state} (wanted: panicked)",
            "the forced panic did not fire, or the panic hook's message never "
            "reached the page (jidousha-platform web/panic.rs and the template "
            "are two halves of one contract)",
            f"read {log.relative_to(REPO_ROOT)}; check the [jidousha panic] marker "
            "arrives on console.error",
        )
    overlay = re.search(r'<pre id="panic-text"[^>]*>(.*?)</pre>', dom, re.S)
    text = overlay.group(1) if overlay else ""
    for required in ("[jidousha] forced test panic", "likely cause:", "fix:"):
        if required not in text:
            return fail(
                "the panic overlay is missing part of the §9 message",
                f"wanted {required!r} in the overlay; overlay text: {text[:200]!r}",
                "the hook truncated the payload, or the page rewrote it instead "
                "of rendering it verbatim",
                "compare the overlay against the §9 shape (core.md §9)",
            )
    print(f"[serve-web] PASS — the forced panic rendered the full §9 overlay")
    return 0


def check_frametime_overlay(browser: str, port: int, example: str) -> int:
    """`?frametime=1` brings up the frame-pacing overlay and names the renderer.

    The overlay is the answer to "the ball is jumpy in my browser" — a page-side
    instrument on every deployed build, reachable by query parameter alone
    (web-publish.md §2). A diagnostic nobody can reach is a diagnostic that
    rots, so it is checked the same way the panic overlay is.
    """
    loaded = load_page(
        browser,
        f"http://127.0.0.1:{port}/{example}/index.html?frametime=1",
        example,
        "frametime",
    )
    if isinstance(loaded, int):
        return loaded
    dom, _shot, log = loaded
    verdict = re.search(r'data-jidousha-frametime="([a-z]+)"', dom)
    if verdict is None:
        return fail(
            f"{example} with ?frametime=1 did not bring up the frame-pacing overlay",
            "no data-jidousha-frametime marker in the page",
            "the overlay's query-parameter gate did not fire, or it threw before "
            "classifying the renderer",
            f"read {log.relative_to(REPO_ROOT)}; open the page with ?frametime=1 yourself",
        )
    classification = verdict.group(1)
    print(f"[serve-web] frametime overlay says the renderer is: {classification}")

    panel = re.search(r'<div id="frametime"([^>]*)>(.*?)\n\s*</div>\s*<div id="status"', dom, re.S)
    shown = 'class="shown"' in (panel.group(1) if panel else "")
    if not shown:
        return fail(
            f"{example} with ?frametime=1 left the overlay hidden",
            f"the marker says {classification} but #frametime never got the shown class",
            "the panel was classified and then not displayed",
            "open the page with ?frametime=1 and look at the top right",
        )

    body = re.search(r'<div id="frametime-body">(.*?)</div>', dom, re.S)
    text = body.group(1) if body else ""
    for required in (
        "present",
        "refresh",
        "scale",
        "renderer",
        "clock",
        "ticks/fr",
        "frame deltas",
    ):
        if required not in text:
            return fail(
                "the frame-pacing overlay is missing one of its readings",
                f"wanted {required!r}; overlay body: {text[:300]!r}",
                "the overlay rendered before it had anything to say, or a reading was dropped",
                "open the page with ?frametime=1 and compare against web-publish.md §2",
            )

    # The measured slow-presentation verdict (web-publish.md §2). This browser
    # is driven under `--virtual-time-budget`, so its frame cadence is synthetic
    # and *which* verdict it reaches is not something to assert — what is worth
    # asserting is that the classifier ran and reached one, because a detector
    # that throws is a detector that silently stops warning anybody.
    presentation = re.search(r'data-jidousha-presentation="([a-z]+)"', dom)
    reached = presentation.group(1) if presentation else None
    if reached not in ("sampling", "ok", "slow"):
        return fail(
            "the frame-pacing overlay did not classify how this browser presents",
            f"data-jidousha-presentation is {reached!r}; wanted sampling, ok or slow",
            "the measured slow-presentation check threw, or never ran a frame",
            f"read {log.relative_to(REPO_ROOT)}; open the page with ?frametime=1 and "
            "read the 'refresh' line",
        )
    print(f"[serve-web] frametime overlay says this browser presents: {reached}")

    # This browser runs on SwiftShader by construction (see `load_page`), so an
    # overlay that cannot see software rendering here cannot see it anywhere.
    if classification != "software":
        return fail(
            "the frame-pacing overlay did not notice it was software-rendering",
            f"it classified this browser as {classification}; it is driven with "
            "--use-angle=swiftshader",
            "the renderer string moved, or WEBGL_debug_renderer_info stopped answering",
            f"read {log.relative_to(REPO_ROOT)} for the renderer the overlay logged, and "
            "widen SOFTWARE_RENDERERS in tools/web-template/index.html to match it",
        )
    warning = re.search(r'<div id="frametime-warning"([^>]*)>(.*?)</div>', dom, re.S)
    if "software-rendering" not in (warning.group(2) if warning else ""):
        return fail(
            "the frame-pacing overlay classified software rendering and did not say so",
            f"warning box: {(warning.group(2) if warning else '')[:200]!r}",
            "the classification and the visible warning came apart",
            "a playtester reads the box, not the data attribute — fix the box",
        )
    print("[serve-web] PASS — ?frametime=1 showed the overlay and caught the software renderer")
    return 0


def check(browser: str, port: int, example: str, windowed: bool = True) -> int:
    """Three passes: the page runs (and draws); the forced panic reaches the
    overlay; the frame-pacing overlay comes up and classifies the renderer.

    The first two need a `windowed` page — both the surface and the forced
    `?panic=1` live behind `platform::run()`, which a console example never
    calls. The third does not: the frame-pacing overlay is the *page's*, and it
    never calls into the module (web-publish.md §2), so it is the same contract
    everywhere and is checked on every page.
    """
    step = check_runs(browser, port, example, windowed)
    if step != 0:
        return step
    if windowed:
        step = check_panic_overlay(browser, port, example)
        if step != 0:
            return step
    else:
        print(
            f"[serve-web] SKIP — {example} has no forced panic to check: "
            "?panic=1 is raised inside platform::run(), which a console example "
            "never calls (checked on every windowed page)"
        )
    return check_frametime_overlay(browser, port, example)


def built_fleet() -> "list[tuple[str, bool]] | None":
    """Every page of the build in `dist/`, in the index's order, with what it
    has to prove: `(page, windowed)`.

    Read from `dist/fleet.txt`, which `build-web` wrote — two columns, the page
    and `windowed` or `console`. The reader never names a page and never knows
    which fleet was built; that is the whole point of the file
    (web-publish.md §3a), and it is what lets one command check whatever this
    build contains.

    A line with no second column reads as `windowed`. That is the stricter of the
    two, so a `fleet.txt` from an older `build-web` makes the check demand more
    rather than less — a lenient default here would silently stop asserting
    that any page draws at all.
    """
    listing = DIST / "fleet.txt"
    if not listing.is_file():
        return None
    pages = []
    for line in listing.read_text(encoding="utf-8").splitlines():
        fields = line.split()
        if fields:
            pages.append((fields[0], fields[1:] != ["console"]))
    return pages


def check_fleet(browser: str, port: int, pages: "list[tuple[str, bool]]") -> int:
    """Check every page of the built fleet; report every page that failed.

    CONTRACT (web-publish.md §3a): what CI checks is what CI built, all of it.
    A build that browser-checks only its first page cannot see a fault in any
    other, and when the two fleets lead with different pages — as they do — a
    page can reach production having never been checked at all. That is not
    hypothetical: it is how a `web build` failure stayed invisible across a PR
    and only appeared on `main` (jidousha#79 through #82, 2026-08-30/09-01).

    Failures do not stop the run. "One page is broken" and "every page is
    broken" call for completely different next moves, and the difference is
    only visible if the rest are tried — so the loop finishes and names all of
    them. The step's wall-clock ceiling belongs in CI, not here.
    """
    failed = []
    for index, (page, windowed) in enumerate(pages, start=1):
        print(f"\n[serve-web] === {page} ({index} of {len(pages)}) ===")
        if check(browser, port, page, windowed) != 0:
            failed.append(page)
    print()
    if failed:
        return fail(
            f"{len(failed)} of {len(pages)} page(s) failed their browser check",
            "failed: " + ", ".join(failed),
            "one page is that page's bug; all of them is the engine, the build or "
            "this machine's browser",
            "each page's browser log and screenshot are under "
            f"{CHECK_DIR.relative_to(REPO_ROOT)}/<page>/; the CI job uploads them on failure",
        )
    print(f"[serve-web] PASS — all {len(pages)} page(s) of this build checked out")
    return 0


def browser_to_check_with() -> "str | int":
    """The headless browser the check drives, or an exit code saying there is none."""
    browser = chromium()
    if browser is None:
        return fail(
            "no headless browser to check with",
            "looked for chromium on PATH and under /opt/pw-browsers",
            "this machine has no browser installed",
            "install Chromium, or set JIDOUSHA_CHROMIUM to one, or drop --check and look "
            "at the page yourself",
        )
    print(f"[serve-web] checking with {browser}")
    return browser


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "example",
        nargs="?",
        help="the built example or game to open, e.g. sprites (see tools/build-web)",
    )
    parser.add_argument("--port", type=int, default=8080)
    parser.add_argument(
        "--check",
        action="store_true",
        help="drive a headless browser at the page and the forced panic, report, exit",
    )
    args = parser.parse_args()

    if not DIST.is_dir():
        return fail(
            "there is nothing to serve",
            f"{DIST.relative_to(REPO_ROOT)}/ does not exist",
            "no web build has been made yet — this tool only serves",
            f"run `tools/build-web {args.example or '<example>'}` first",
        )
    if args.example and not (DIST / args.example / "index.html").exists():
        return fail(
            f"{args.example} is not built",
            f"dist/{args.example}/index.html does not exist",
            "it was never built for the web, or was built under another name",
            f"run `tools/build-web {args.example}` first",
        )
    # `--check` with no page checks the whole build. Naming one checks that one
    # — for a local iteration on the page you are working on. Both are the same
    # check; the argument only says how much of the build to run it over.
    pages = [(args.example, True)] if args.example else built_fleet()
    if args.check and pages is None:
        return fail(
            "there is no fleet listing to check",
            "dist/fleet.txt does not exist",
            "dist/ was written by something other than build-web, or by a build-web "
            "too old to list its fleet",
            "run `tools/build-web --all` (or `--release-fleet`), then check again",
        )

    server = serve(args.port, DIST)
    try:
        if args.check:
            browser = browser_to_check_with()
            if isinstance(browser, int):
                return browser
            if args.example:
                # Look the named page up in the fleet, so `serve-web
                # headless_sim --check` asserts exactly what CI asserts for it.
                # Absent from the listing (an unbuilt or hand-made dist/), it is
                # a windowed page — the stricter reading.
                listed = dict(built_fleet() or [])
                return check(
                    browser, args.port, args.example, listed.get(args.example, True)
                )
            return check_fleet(browser, args.port, pages or [])
        where = f"/{args.example}/" if args.example else "/"
        print(f"[serve-web] http://127.0.0.1:{args.port}{where}  —  Ctrl-C to stop")
        try:
            while True:
                time.sleep(3600)
        except KeyboardInterrupt:
            print("\n[serve-web] stopped")
            return 0
    finally:
        server.shutdown()


if __name__ == "__main__":
    sys.exit(main())
