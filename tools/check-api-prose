#!/usr/bin/env python3
"""tools/check-api-prose — compile every `rust` block in the hand-written API prose.

`docs/api/` is generated from two halves and only one of them was ever checked.
The reference half comes from the facade's doc comments, whose examples are
doctests: `tools/test`'s `doc-test` phase compiles and runs all forty-nine of
them. The prose half — `tools/api-doc/concepts.md`, `testing.md`,
`controllers.md` — is hand-written, and its code blocks were compiled by nothing
at all. Every gate in the repository checked that document's formatting, its
vocabulary, its example pointers and its token budget, and none of them checked
whether its code was code.

That is not hypothetical. E0 run 4 found the document's two recorder snippets to
be a borrow error *when written one after the other* (e0-findings.md F-040) —
each fine alone, and the reader who follows the document writes both. A compiler
finds that in a second and no reviewer reliably does.

**Blocks are fragments, so they are given context with rustdoc's `# ` prefix.**
A hidden line is compiled and never rendered: `tools/gen-api-doc`'s
`visible_prose` drops it on the way to `docs/api/`, so the page keeps the
fragment the surrounding sentence is written against and the token budget pays
nothing. `##` at the start of a line is an escaped literal `#`, and `#[derive(…)]`
is an attribute; neither is setup.

Every block is wrapped in a function body, which is legal for statements and for
items alike — a `struct`, an `impl`, a `const` and a `use` are all allowed inside
a `fn` — so no block needs to declare which kind it is. Nothing is run: a
fragment's *value* is the sentence beside it, and what a fragment can be wrong
about is whether it compiles.

Exit codes: 0 every block compiles · 1 a block does not · 2 the harness could not
build the facade.

Key functions: `blocks_in`, `harness_source`, `report`.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PROSE = REPO_ROOT / "tools" / "api-doc"
CRATE = "jidousha"
CRATE_LIB = "jidousha"
BUILD_TIMEOUT_S = 900
COMPILE_TIMEOUT_S = 180
# Where the compiled metadata is discarded. A real path under `target/` rather
# than `/dev/null`, because rustc puts its temp directory beside `-o` — see
# `compile_harness`.
METADATA_SINK = REPO_ROOT / "target" / "api-prose.rmeta"

FENCE_RE = re.compile(r"^\s*```(\w*)\s*$")

# What a block is compiled against. The prose's own promise is that everything is
# reachable from one import, so the harness takes exactly that import and no
# other: a block needing a name the prelude does not carry has to say so in a
# hidden line, which is the same thing it would ask of a reader.
PREAMBLE = """#![allow(
    unused_variables,
    unused_mut,
    unused_imports,
    dead_code,
    path_statements,
    clippy::all,
    clippy::pedantic
)]
use jidousha::prelude::*;
use jidousha::testing::*;

/// The game a block is a fragment of.
///
/// Prose blocks are fragments by design — the sentence beside one is what says
/// what it is for — so each needs a game around it before it is a program. The
/// *game-shaped* half of that context lives here rather than on a hidden line in
/// every block, because it is the same fiction each time and the prose already
/// names it as the reader\'s own: `Score` is your score, `my_system` is your
/// system. The per-block half — a `sim` to tick, a `frame` to measure — stays on
/// a hidden line beside the block, where a maintainer editing that block sees it.
///
/// Nothing here is exported or shipped. It exists so that `rustc` can be asked
/// the one question a fragment can be wrong about: does this compile.
mod game {
    use super::*;

    #[derive(Clone, Copy, Debug, PartialEq)]
    pub struct Score(pub u32);
    impl Resource for Score {}

    #[derive(Clone, Copy, Debug)]
    pub struct Scoreboard {
        pub left: u32,
        pub right: u32,
    }
    impl Resource for Scoreboard {}

    #[derive(Clone, Copy, Debug)]
    pub struct Velocity(pub Vec2);
    impl Component for Velocity {}

    pub struct Player;
    impl Component for Player {}

    pub struct Frozen;
    impl Component for Frozen {}

    pub const TICKS: u32 = 600;
    pub const HINT: &str = "W and S to move";

    pub mod palette {
        use super::Color;
        pub const COURT: Color = Color::rgba(0.04, 0.05, 0.07, 1.0);
    }

    pub mod verify {
        pub fn run() -> std::process::ExitCode {
            std::process::ExitCode::SUCCESS
        }
    }

    pub fn my_system(_world: &mut World) {}
    pub fn setup(_app: &mut App) {}
    pub fn build_game(_app: &mut App) {}
    pub fn score_of(_sim: &HeadlessSim) -> u32 {
        0
    }

    /// A built game, before its first tick.
    pub fn sim() -> HeadlessSim {
        headless(GameConfig::default(), build_game)
    }

    /// A game that has been ticked, with the frame and camera a check reads.
    pub fn played() -> (HeadlessSim, FrameRecorder, FrameRecord, Camera) {
        let mut sim = sim();
        let mut recorder = FrameRecorder::new(PhysicalSize::new(1280, 720));
        sim.tick();
        let frame = recorder.draw(&mut sim);
        let camera = Camera::default();
        (sim, recorder, frame, camera)
    }
}
use game::*;
"""


def blocks_in(path: Path) -> "list[tuple[int, list[str]]]":
    """Every ```rust block in one prose file, as (first body line number, lines).

    The line number is of the block's first *body* line, 1-based, so a compiler
    error can be reported against the file a maintainer edits rather than against
    the generated harness.
    """
    found, current, start = [], None, 0
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        fence = FENCE_RE.match(line)
        if fence and current is None:
            if fence.group(1) == "rust":
                current, start = [], number + 1
            continue
        if fence and current is not None:
            found.append((start, current))
            current = None
            continue
        if current is not None:
            current.append(line)
    return found


def unhide(lines: "list[str]") -> "list[str]":
    """A block as the compiler sees it: hidden lines revealed, escapes resolved."""
    out = []
    for line in lines:
        stripped = line.lstrip()
        if stripped.startswith("##"):
            out.append(line.replace("##", "#", 1))
        elif stripped == "#":
            out.append("")
        elif stripped.startswith("# "):
            out.append(line.replace("# ", "", 1))
        else:
            out.append(line)
    return out


def harness_source(sources: "list[tuple[Path, int, list[str]]]") -> "tuple[str, list[tuple[Path, int]]]":
    """One compilable file holding every block, and the map back to the prose.

    Returns the source and a list indexed by harness function number, so an error
    reported at `fn block_7` names the file and line block 7 came from.
    """
    text = [PREAMBLE]
    origins = []
    for index, (path, start, lines) in enumerate(sources):
        origins.append((path, start))
        text.append(f"fn block_{index}() {{")
        text.extend(unhide(lines))
        text.append("}")
    return "\n".join(text) + "\n", origins


def find_rlib(build_output: str, crate_name: str) -> "str | None":
    """The rlib cargo just built for `crate_name`, from its JSON message stream."""
    newest = None
    for line in build_output.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if message.get("reason") != "compiler-artifact":
            continue
        if message.get("target", {}).get("name") != crate_name:
            continue
        for filename in message.get("filenames", []):
            if filename.endswith(".rlib"):
                newest = filename
    return newest


def build_facade() -> "str | None":
    proc = subprocess.run(
        ["cargo", "build", "-p", CRATE, "--message-format=json"],
        cwd=REPO_ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=BUILD_TIMEOUT_S,
        text=True,
    )
    if proc.returncode != 0:
        print(f"[check-api-prose] could not build {CRATE}:\n{proc.stderr}", file=sys.stderr)
        return None
    return find_rlib(proc.stdout, CRATE_LIB)


def compile_harness(source: Path, rlib: str) -> "tuple[int, str]":
    """Compile the harness, discarding the metadata into `target/`.

    **Not `-o /dev/null`.** rustc creates its temporary output directory beside
    the path `-o` names, so `-o /dev/null` asks it to write into `/dev` — which
    works for a root user and fails on any CI runner with

        couldn't create a temp dir: Permission denied (os error 13)
            at path "/dev/rmetaZ1us3X"

    and no mention of `-o` anywhere in the message. This is where the metadata
    goes instead: a real, writable, git-ignored path beside the generated
    harness. `tools/check-compile-fail` had the same line and never hit it,
    because every snippet it compiles is *meant* to fail and rustc aborts before
    it emits anything.
    """
    deps = Path(rlib).parent
    proc = subprocess.run(
        [
            "rustc",
            "--edition",
            "2024",
            "--crate-type",
            "lib",
            "--emit=metadata",
            "-o",
            str(METADATA_SINK),
            "-L",
            f"dependency={deps}",
            "-L",
            f"dependency={deps / 'deps'}",
            "--extern",
            f"{CRATE_LIB}={rlib}",
            str(source),
        ],
        cwd=REPO_ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=COMPILE_TIMEOUT_S,
        text=True,
    )
    return proc.returncode, proc.stderr


BLOCK_RE = re.compile(r"\bblock_(\d+)\b")


def report(stderr: str, origins: "list[tuple[Path, int]]") -> None:
    """rustc's output, with every block named by the prose file it lives in.

    The harness is a generated file in `target/`, and an error pointing there is
    an error pointing at a file nobody edits. Each `block_N` in the output is
    followed by the prose file and line it came from, which is where the fix goes.
    """
    print(stderr.rstrip())
    named = sorted({int(m.group(1)) for m in BLOCK_RE.finditer(stderr)})
    if not named:
        return
    print("\n[check-api-prose] the blocks named above:")
    for index in named:
        if index < len(origins):
            path, line = origins[index]
            print(f"  block_{index} — {path.relative_to(REPO_ROOT)}:{line}")


def main() -> int:
    sources = []
    for path in sorted(PROSE.glob("*.md")):
        for start, lines in blocks_in(path):
            sources.append((path, start, lines))
    files = len({path for path, _, _ in sources})
    print(f"[check-api-prose] {len(sources)} rust block(s) across {files} prose file(s)")
    if not sources:
        return 0

    rlib = build_facade()
    if rlib is None:
        print("[check-api-prose] no rlib to compile against", file=sys.stderr)
        return 2

    source, origins = harness_source(sources)
    generated = REPO_ROOT / "target" / "api-prose.rs"
    generated.parent.mkdir(parents=True, exist_ok=True)
    generated.write_text(source, encoding="utf-8")

    code, stderr = compile_harness(generated, rlib)
    if code != 0:
        report(stderr, origins)
        print(
            "\n[check-api-prose] the API prose contains code that does not compile.\n"
            "  likely cause: the surface changed under a hand-written block, or a new\n"
            "                block was written against a name the prelude does not carry.\n"
            "  fix: correct the block in tools/api-doc/, or give it the context it needs\n"
            "       on a hidden `# ` line — hidden lines compile and are never rendered.\n"
            f"  the generated harness, for reading: {generated.relative_to(REPO_ROOT)}"
        )
        return 1
    print("[check-api-prose] every block compiles")
    return 0


if __name__ == "__main__":
    sys.exit(main())
